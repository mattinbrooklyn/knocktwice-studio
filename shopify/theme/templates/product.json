            "custom_liquid_f6XJ3B": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"kt-product-title-price\">\n  <h1 class=\"kt-product-title\">\n    {{ product.title | upcase }}\n  </h1>\n\n \n</div>\n\n<style>\n  .kt-product-title-price {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    width: 100%;\n    margin-bottom: 28px;\n  }\n\n  .kt-product-title {\n    margin: 0;\n    font-size: clamp(22px, 1vw, 26px);\n    line-height: 0.95;\n    font-weight: 900;\n    letter-spacing: -1px;\n    text-transform: uppercase;\n  }\n\n  .kt-product-price {\n    font-size: clamp(14px, 1vw, 16px);\n    line-height: 1;\n    font-weight: 900;\n    white-space: nowrap;\n  }\n\n  @media screen and (max-width: 749px) {\n    .kt-product-title-price {\n      align-items: flex-start;\n      gap: 12px;\n    }\n\n    .kt-product-title {\n      font-size: 30px;\n    }\n\n    .kt-product-price {\n      font-size: 22px;\n      padding-top: 4px;\n    }\n  }\n</style>"
              },
              "blocks": {}
            },
            "custom_liquid_JythCJ": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{%- assign color = product.title | split: ' ' | last -%}\n\n<div class=\"kt-product-meta\">\n  <p class=\"kt-product-color\">{{ product.tags[0] }}</p>\n  <p class=\"kt-product-price\">{{ product.price | money }}</p>\n</div>\n\n<style>\n  .kt-product-meta {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 24px;\n    width: 100%;\n    margin-top: 15px;     /* Figma: title ends 277, row starts 292 */\n  }\n\n  .kt-product-color,\n  .kt-product-price {\n    margin: 0;\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: 22px;\n    line-height: 27px;\n    font-weight: 400;\n    letter-spacing: 0;\n    color: #32261F;\n     text-transform:capitalize\n  }\n\n  .kt-product-price {\n    text-align: right;\n    white-space: nowrap;\n  }\n</style>"
              },
              "blocks": {},
              "disabled": true
            },
            "custom_liquid_7bcj9k": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"kt-product-description\">\n  {{ product.description }}\n</div>\n\n<style>\n  .kt-product-description {\n    width: 100%;\n    margin-top: 15px;      /* Figma: price row ends 319, description starts 334 */\n    margin-bottom: 30px;   /* Figma: description ends 410, Quantity label 440 */\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: 14px;       /* B1/Web */\n    line-height: 22px;\n    font-weight: 400;\n    letter-spacing: 0;\n    color: #32261F;\n  }\n\n  /* Shopify's rich text field emits <p>, <ul>, <strong> etc. — reset then respace */\n  .kt-product-description p,\n  .kt-product-description ul,\n  .kt-product-description ol {\n    margin: 0;\n  }\n\n  .kt-product-description p + p,\n  .kt-product-description p + ul,\n  .kt-product-description p + ol,\n  .kt-product-description ul + p,\n  .kt-product-description ol + p {\n    margin-top: 10px;      /* Figma: paragraph spacing */\n  }\n\n  .kt-product-description ul,\n  .kt-product-description ol {\n    padding-left: 20px;\n  }\n\n  .kt-product-description li + li {\n    margin-top: 4px;       /* Figma: list spacing */\n  }\n\n  .kt-product-description strong,\n  .kt-product-description b {\n    font-weight: 700;\n  }\n\n  .kt-product-description a {\n    color: #378CDA;\n    text-decoration: underline;\n  }\n\n  .kt-product-description > *:first-child { margin-top: 0; }\n  .kt-product-description > *:last-child { margin-bottom: 0; }\n</style>"
              },
              "blocks": {}
            },
            "custom_liquid_B4biNn": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{%- liquid\n  assign kt_hidden = product.metafields.custom.hidden_sections.value | join: '|' | prepend: '|' | append: '|'\n  assign kt_show = true\n  if kt_hidden contains '|Quantity|' or product.metafields.custom.quantity_selector.value == false\n    assign kt_show = false\n  endif\n-%}\n{%- if kt_show -%}\n<div class=\"kt-qty\" data-kt-qty>\n  <label class=\"kt-qty__label\" for=\"kt-qty-input\">Quantity</label>\n\n  <div class=\"kt-qty__control\">\n    <button type=\"button\" class=\"kt-qty__btn kt-qty__btn--minus\" data-kt-qty-step=\"-1\" aria-label=\"Decrease quantity\"></button>\n    <input class=\"kt-qty__input\" id=\"kt-qty-input\" name=\"quantity\" type=\"number\"\n           min=\"1\" step=\"1\" value=\"1\" inputmode=\"numeric\" aria-label=\"Quantity\">\n    <button type=\"button\" class=\"kt-qty__btn kt-qty__btn--plus\" data-kt-qty-step=\"1\" aria-label=\"Increase quantity\"></button>\n  </div>\n</div>\n\n<style>\n  .kt-qty {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;              /* Figma: label 440–463, pill top 473 */\n    width: 100%;\n    margin-bottom: 30px;    /* Figma: pill bottom 528, next heading 558 */\n  }\n\n  .kt-qty__label {\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: 14px;        /* B3/Web */\n    line-height: 22px;\n    font-weight: 700;\n    color: #32261F;\n  }\n\n  .kt-qty__control {\n    display: grid;\n    grid-template-columns: 54px 1fr 54px;  /* 54 + 2px border = 56px cap */\n    align-items: stretch;\n    height: 55px;\n    border: 2px solid #32261F;\n    border-radius: 100px;\n    background: #FFFFFF;\n    overflow: hidden;\n  }\n\n  .kt-qty__btn {\n    position: relative;\n    appearance: none;\n    border: 0;\n    background: transparent;\n    color: #32261F;\n    cursor: pointer;\n    padding: 0;\n    transition: background-color 120ms ease, color 120ms ease;\n  }\n\n  /* Dividers */\n  .kt-qty__btn--minus { border-right: 2px solid #32261F; }\n  .kt-qty__btn--plus  { border-left:  2px solid #32261F; }\n\n  /* Glyphs drawn as 16px bars, 2px thick — Figma spec */\n  .kt-qty__btn::before,\n  .kt-qty__btn::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    background: currentColor;\n    transform: translate(-50%, -50%);\n  }\n\n  .kt-qty__btn::before { width: 16px; height: 2px; }\n  .kt-qty__btn--plus::after { width: 2px; height: 16px; }\n\n  /* Hover: blue cell, white glyph */\n  .kt-qty__btn:hover {\n    background-color: #378CDA;\n    color: #FFFFFF;\n  }\n\n  .kt-qty__btn:focus-visible {\n    background-color: #378CDA;\n    color: #FFFFFF;\n    outline: none;\n  }\n\n  /* At minimum quantity: dim the minus button */\n  .kt-qty__btn:disabled {\n    cursor: default;\n    opacity: 0.35;\n    background-color: transparent;\n    color: #32261F;\n  }\n\n  .kt-qty__input {\n    appearance: none;\n    -moz-appearance: textfield;\n    border: 0;\n    background: transparent;\n    color: #32261F;\n    font-family: 'Handjet', sans-serif;\n    font-size: 16px;\n    line-height: 22px;\n    font-weight: 700;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n    text-align: center;\n    min-width: 0;\n    padding: 0;\n  }\n\n  .kt-qty__input:focus { outline: none; }\n\n  .kt-qty__input::-webkit-outer-spin-button,\n  .kt-qty__input::-webkit-inner-spin-button {\n    -webkit-appearance: none;\n    margin: 0;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .kt-qty__btn { transition: none; }\n  }\n</style>\n\n<script>\n  const ktQtyInit = () => {\n    document.querySelectorAll('[data-kt-qty]').forEach((root) => {\n      if (root.dataset.ktQtyReady) return;\n      root.dataset.ktQtyReady = 'true';\n\n      const input = root.querySelector('.kt-qty__input');\n      if (!input) return;\n\n      // Connect the quantity box to this section's Add to Cart form\n      const section = root.closest('.shopify-section') || document;\n      const form = section.querySelector('form[action*=\"/cart/add\"]');\n      const formId = form && form.getAttribute('id');\n      if (formId) input.setAttribute('form', formId);\n\n      const min = () => Number(input.min) || 1;\n      const clamp = (n) => Math.max(min(), Math.floor(Number(n)) || min());\n      const update = () => {\n        root.querySelector('[data-kt-qty-step=\"-1\"]').disabled = clamp(input.value) <= min();\n      };\n\n      root.addEventListener('click', (e) => {\n        const btn = e.target.closest('[data-kt-qty-step]');\n        if (!btn) return;\n        input.value = clamp(Number(input.value) + Number(btn.dataset.ktQtyStep));\n        input.dispatchEvent(new Event('change', { bubbles: true }));\n        update();\n      });\n\n      input.addEventListener('change', () => {\n        input.value = clamp(input.value);\n        update();\n      });\n\n      update();\n    });\n  };\n\n  // Run after the whole page loads, so the Add to Cart form (which comes after this block) exists\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', ktQtyInit);\n  } else {\n    ktQtyInit();\n  }\n</script>\n{%- endif -%}"
              },
              "blocks": {}
            },
            "custom_liquid_Cm7Rt4": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{%- liquid\n  assign kt_hidden = product.metafields.custom.hidden_sections.value | join: '|' | prepend: '|' | append: '|'\n  assign kt_show = true\n  if kt_hidden contains '|Photo upload|' or product.metafields.custom.photo_upload.value == false\n    assign kt_show = false\n  endif\n-%}\n{%- if kt_show -%}\n<div class=\"kt-upload\" data-kt-upload>\n  <p class=\"kt-upload__heading\">No polaroid? No problem.</p>\n  <p class=\"kt-upload__body\">Upload your photo and we'll print it and tuck it in with your order.</p>\n\n  <label class=\"kt-upload__button\" for=\"kt-upload-input\">\n    <span class=\"kt-upload__text\">Add Photo</span>\n    <svg class=\"kt-upload__icon\" width=\"18\" height=\"17\" viewBox=\"0 0 18 17\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M9 11V2M9 2L5.5 5.5M9 2l3.5 3.5\"\n            stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <path d=\"M2 11.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5\"\n            stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    <input class=\"kt-upload__input\" id=\"kt-upload-input\" type=\"file\"\n           name=\"properties[Photo]\"\n           accept=\".jpg,.jpeg,.png,.tif,.tiff,image/jpeg,image/png,image/tiff\">\n  </label>\n\n  <p class=\"kt-upload__error\" data-kt-upload-error hidden>Hmm. That format is not supported try again (.jpg, .png, .tiff)</p>\n\n  <p class=\"kt-upload__file\" data-kt-upload-file hidden>\n    <a class=\"kt-upload__file-link\" data-kt-upload-link target=\"_blank\" rel=\"noopener\">\n      <svg class=\"kt-upload__file-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n        <rect x=\"1\" y=\"2\" width=\"16\" height=\"14\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"2\"/>\n        <circle cx=\"6\" cy=\"7\" r=\"1.3\" fill=\"currentColor\"/>\n        <path d=\"M2 13l4-4 3.5 3.5L12 10l4 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n      <span class=\"kt-upload__file-name\" data-kt-upload-name></span>\n    </a>\n    <button type=\"button\" class=\"kt-upload__remove\" data-kt-upload-remove aria-label=\"Remove photo\">&times;</button>\n  </p>\n</div>\n\n<style>\n  .kt-upload {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    margin-bottom: 24px;\n  }\n\n  .kt-upload__heading {\n    margin: 0;\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: var(--kt-type-b1, 14px);        /* B3/Web */\n    line-height: var(--kt-leading-b1, 22px);\n    font-weight: 700;\n    color: #32261F;\n  }\n\n  .kt-upload__body {\n    margin: 5px 0 10px;     /* Figma: 5px below heading, 10px above button */\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: var(--kt-type-b1, 14px);        /* B1/Web */\n    line-height: var(--kt-leading-b1, 22px);\n    font-weight: 400;\n    color: #32261F;\n  }\n\n  .kt-upload__button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;              /* Figma: text ends 1154, icon starts 1164 */\n    height: 55px;\n    border: 2px solid #32261F;\n    border-radius: 100px;\n    background: #FFFFFF;\n    color: #32261F;\n    cursor: pointer;\n    transition: background-color 120ms ease, color 120ms ease, opacity 120ms ease;\n  }\n\n  .kt-upload__text {\n    font-family: 'Handjet', sans-serif;\n    font-size: var(--kt-type-button, 16px);\n    line-height: var(--kt-leading-button, 22px);\n    font-weight: 700;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n  }\n\n  .kt-upload__icon { flex: none; }\n\n  /* Hover: blue fill, off-white text + icon */\n  .kt-upload__button:hover,\n  .kt-upload__button:focus-within {\n    background-color: #378CDA;\n    color: #F7F2EC;\n  }\n\n  .kt-upload__input {\n    position: absolute;\n    width: 1px; height: 1px;\n    padding: 0; margin: -1px;\n    overflow: hidden;\n    clip-path: inset(50%);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  /* ── Error state ─────────────────────────────── */\n  .kt-upload__error {\n    margin: 8px 0 0;\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: var(--kt-type-b1, 14px);\n    line-height: var(--kt-leading-b1, 22px);\n    color: #FF0004;\n  }\n\n  /* ── Success state: photo attached ───────────── */\n  .kt-upload__file {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin: 8px 0 0;\n    min-width: 0;\n  }\n\n  /* Without this the rules above would beat the hidden attribute */\n  .kt-upload__file[hidden],\n  .kt-upload__error[hidden] {\n    display: none;\n  }\n\n  .kt-upload__file-link {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    min-width: 0;\n    color: #378CDA;\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: var(--kt-type-b1, 14px);\n    line-height: var(--kt-leading-b1, 22px);\n    font-weight: 700;\n    text-decoration: none;\n    cursor: pointer;\n  }\n\n  .kt-upload__file-link:hover .kt-upload__file-name {\n    text-decoration: underline;\n  }\n\n  .kt-upload__file-icon { flex: none; }\n\n  /* One line only — longer names truncate with … */\n  .kt-upload__file-name {\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .kt-upload__remove {\n    flex: none;\n    appearance: none;\n    border: 0;\n    padding: 0;\n    background: none;\n    color: #378CDA;\n    font: inherit;\n    font-size: 20px;\n    line-height: 1;\n    cursor: pointer;\n  }\n\n  /* One photo per order: button is disabled while a photo is attached */\n  .kt-upload.is-filled .kt-upload__button {\n    opacity: 0.5;\n    cursor: default;\n  }\n  .kt-upload.is-filled .kt-upload__button:hover,\n  .kt-upload.is-filled .kt-upload__button:focus-within {\n    background: #FFFFFF;\n    color: #32261F;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .kt-upload__button { transition: none; }\n  }\n</style>\n\n<script>\n  (function () {\n    // \"No polaroid? No problem.\" — one photo per frame ordered.\n    // The customer can add up to as many photos as the Quantity box says.\n    // Each photo rides on the Add to Cart form as its own line item\n    // property: \"Photo\" when there is one, \"Photo 1\", \"Photo 2\"… when more.\n    function ktUploadInit() {\n      var root = document.querySelector('[data-kt-upload]');\n      if (!root || root.dataset.ktUploadReady) return;\n      root.dataset.ktUploadReady = 'true';\n\n      var picker = root.querySelector('.kt-upload__input');\n      var button = root.querySelector('.kt-upload__button');\n      var error = root.querySelector('[data-kt-upload-error]');\n      var template = root.querySelector('[data-kt-upload-file]');\n      var allowed = /\\.(jpe?g|png|tiff?)$/i;\n      var photos = []; // { input, row, url }\n\n      var section = root.closest('.shopify-section') || document;\n      var form = section.querySelector('form[action*=\"/cart/add\"]');\n      var formId = form && form.getAttribute('id');\n      var qtyInput = section.querySelector('.kt-qty__input') || document.querySelector('.kt-qty__input');\n\n      // The picker only opens the file dialog; picked files move to their\n      // own hidden input so the picker is free for the next photo.\n      picker.removeAttribute('name');\n      picker.removeAttribute('form');\n\n      var holder = document.createElement('div');\n      holder.hidden = true;\n      root.appendChild(holder);\n\n      // Clones of the original file row go here, one per photo\n      var list = document.createElement('div');\n      list.className = 'kt-upload__files';\n      template.parentNode.insertBefore(list, template.nextSibling);\n\n      function limit() {\n        var n = qtyInput ? Math.floor(Number(qtyInput.value)) : 1;\n        return n > 0 ? n : 1;\n      }\n\n      function renumber() {\n        photos.forEach(function (p, i) {\n          p.input.name = photos.length === 1 ? 'properties[Photo]' : 'properties[Photo ' + (i + 1) + ']';\n        });\n      }\n\n      function refresh() {\n        renumber();\n        // Same greyed-out button state as before, now only once every frame has a photo\n        root.classList.toggle('is-filled', photos.length >= limit());\n      }\n\n      function remove(photo) {\n        URL.revokeObjectURL(photo.url);\n        photo.input.remove();\n        photo.row.remove();\n        photos.splice(photos.indexOf(photo), 1);\n        refresh();\n      }\n\n      function onPick() {\n        error.hidden = true;\n        var file = picker.files && picker.files[0];\n        if (!file) return;\n\n        if (!allowed.test(file.name) || photos.length >= limit()) {\n          picker.value = '';\n          if (!allowed.test(file.name)) error.hidden = false;\n          return;\n        }\n\n        // The picker now holds this photo: name it, put it on the cart\n        // form, and swap an empty picker into the button for the next one\n        var input = picker;\n        var fresh = input.cloneNode(); // a clone never carries the file\n        fresh.addEventListener('change', onPick);\n        input.parentNode.replaceChild(fresh, input);\n        picker = fresh;\n\n        input.removeAttribute('id');\n        input.classList.add('kt-upload__input--photo');\n        if (formId) input.setAttribute('form', formId);\n        holder.appendChild(input);\n\n        var row = template.cloneNode(true);\n        row.hidden = false;\n        row.removeAttribute('data-kt-upload-file');\n        var url = URL.createObjectURL(file);\n        row.querySelector('[data-kt-upload-link]').href = url;\n        row.querySelector('[data-kt-upload-name]').textContent = file.name;\n        list.appendChild(row);\n\n        var photo = { input: input, row: row, url: url };\n        row.querySelector('[data-kt-upload-remove]').addEventListener('click', function () {\n          remove(photo);\n          error.hidden = true;\n        });\n        photos.push(photo);\n        refresh();\n      }\n\n      picker.addEventListener('change', onPick);\n\n      // Fewer frames than photos: drop the newest photos to match\n      if (qtyInput) {\n        qtyInput.addEventListener('change', function () {\n          while (photos.length > limit()) remove(photos[photos.length - 1]);\n          refresh();\n        });\n      }\n\n      // Every frame has a photo, or an upload is running: the button does\n      // not open the file picker\n      button.addEventListener('click', function (event) {\n        if (root.classList.contains('is-filled') || root.classList.contains('is-uploading')) event.preventDefault();\n      });\n\n      // Add to Cart uploads the photos with the order, which can take a few\n      // seconds for big phone photos. Show that it's working, then clear the\n      // photos and quantity once the frames are in the cart. If it fails,\n      // keep everything so the customer can try again.\n      var label = root.querySelector('.kt-upload__text');\n      var labelText = label ? label.textContent : '';\n      var nativeFetch = window.fetch;\n      window.fetch = function (resource, options) {\n        var url = String(resource && resource.url ? resource.url : resource);\n        var body = options && options.body;\n        var carriesPhotos = /\\/cart\\/add/.test(url) && photos.length > 0 &&\n          typeof FormData !== 'undefined' && body instanceof FormData &&\n          photos.some(function (p) { return body.has(p.input.name); });\n        var request = nativeFetch.apply(this, arguments);\n        if (!carriesPhotos) return request;\n\n        root.classList.add('is-uploading');\n        if (label) label.textContent = 'Uploading…';\n        var done = function () {\n          root.classList.remove('is-uploading');\n          if (label) label.textContent = labelText;\n        };\n        request.then(function (response) {\n          done();\n          if (!response.ok) return;\n          while (photos.length) remove(photos[photos.length - 1]);\n          if (qtyInput) {\n            qtyInput.value = qtyInput.min || 1;\n            qtyInput.dispatchEvent(new Event('change', { bubbles: true }));\n          }\n          refresh();\n        }, done);\n        return request;\n      };\n\n      var style = document.createElement('style');\n      style.textContent = '[data-kt-upload].is-uploading .kt-upload__files { opacity: .5; }' +\n        '[data-kt-upload].is-uploading .kt-upload__button { cursor: progress; }';\n      root.appendChild(style);\n\n      refresh();\n    }\n\n    // Run after the whole page loads, so the Add to Cart form (which comes\n    // after this block) exists and the photos can be attached to it\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', ktUploadInit);\n    } else {\n      ktUploadInit();\n    }\n  })();\n</script>\n{%- endif -%}"
              },
              "blocks": {}
            },
            "custom_liquid_XU3Twy": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "disabled": true,
              "settings": {
                "custom_liquid": "<div class=\"kt-select-field\">\n  <label class=\"kt-select-label\" for=\"kt-size-select\">Select Size:</label>\n\n  <div class=\"kt-select-wrap\">\n    <select\n      id=\"kt-size-select\"\n      class=\"kt-custom-select\"\n      name=\"properties[Size]\"\n      required\n      aria-label=\"Select Size\"\n    >\n     \n      <option value=\"8 x 10”\">8 x 10”</option>\n    </select>\n\n    <span class=\"kt-select-arrow\" aria-hidden=\"true\"></span>\n  </div>\n</div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var sizeSelect = document.getElementById('kt-size-select');\n    var productForm = document.querySelector('form[action*=\"/cart/add\"]');\n\n    if (!sizeSelect || !productForm) return;\n\n    if (!productForm.id) {\n      productForm.id = 'kt-product-form-' + Date.now();\n    }\n\n    sizeSelect.setAttribute('form', productForm.id);\n  });\n</script>\n\n<style>\n  .kt-select-field {\n    width: 100%;\n    margin: 22px 0 24px;\n  }\n\n  .kt-select-label {\n    display: block;\n    margin-bottom: 14px;\n    font-size: 16px;\n    line-height: 1.2;\n    font-weight: 400;\n    color: #2c221d;\n  }\n\n  .kt-select-wrap {\n    position: relative;\n    width: 100%;\n  }\n\n  .kt-custom-select {\n    width: 100%;\n    min-height: 50px;\n    padding: 0 72px 0 24px;\n    border: 3px solid #2c221d;\n    border-radius: 999px;\n    background: transparent;\n    color: #2c221d;\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1;\n    appearance: none;\n    -webkit-appearance: none;\n    cursor: pointer;\n  }\n\n  .kt-custom-select:focus {\n    outline: none;\n    box-shadow: 0 0 0 2px rgba(44, 34, 29, 0.15);\n  }\n\n  .kt-select-arrow {\n    position: absolute;\n    right: 28px;\n    top: 50%;\n    width: 18px;\n    height: 18px;\n    border-right: 3px solid #2c221d;\n    border-bottom: 3px solid #2c221d;\n    transform: translateY(-65%) rotate(45deg);\n    pointer-events: none;\n  }\n\n  @media screen and (max-width: 749px) {\n    .kt-custom-select {\n      min-height: 58px;\n      padding-left: 20px;\n      font-size: 16px;\n    }\n\n    .kt-select-label {\n      font-size: 16px;\n    }\n\n    .kt-select-arrow {\n      width: 20px;\n      height: 20px;\n      right: 24px;\n    }\n  }\n</style>"
