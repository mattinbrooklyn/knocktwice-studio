            "custom_liquid_weUTNt": {
              "type": "custom-liquid",
              "name": "Sold Out/Coming Soon + Waitlist",
              "settings": {
                "custom_liquid": "{%- comment -%}\n  Coming Soon / Sold Out (spec No. 17)\n  Driven by the product metafield custom.launch_status\n  (\"Available\" / \"Coming Soon\" / \"Sold Out\"). When it's Coming Soon or\n  Sold Out: hides Quantity, \"No polaroid?\" upload and Add to Cart, and\n  shows the pill + waitlist form instead. Set it back to \"Available\" and\n  the page is live again — no code changes.\n{%- endcomment -%}\n{%- liquid\n  assign kt_status = product.metafields.custom.launch_status.value | default: ''\n-%}\n{%- if kt_status == 'Coming Soon' or kt_status == 'Sold Out' -%}\n<style>\n  /* Buying is off while the product isn't live */\n  div:has(> .kt-qty),\n  div:has(> .kt-upload),\n  .buy-buttons-block {\n    display: none !important;\n  }\n\n  .kt-waitlist {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    margin-top: 0.5rem;\n  }\n  .kt-waitlist__pill {\n    align-self: center;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    height: 4.125rem;\n    padding: 0 2rem;\n    border-radius: 100px;\n    background: #FADB4B;\n    color: var(--kt-ink);\n    font-family: 'Erica One', serif;\n    font-size: 1.375rem;\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n  .kt-waitlist__heading,\n  .kt-waitlist__body {\n    margin: 0;\n    color: var(--kt-ink);\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: var(--kt-type-b1);\n    line-height: var(--kt-leading-b1);\n  }\n  .kt-waitlist__heading {\n    margin-top: 2rem;\n    font-weight: 700;\n  }\n  .kt-waitlist__body {\n    font-weight: 400;\n  }\n  .kt-waitlist__form {\n    display: flex;\n    flex-direction: column;\n    gap: 1.375rem;\n    margin-top: 1.375rem;\n  }\n  /* input.* + !important: the theme's own input styles otherwise win */\n  .kt-waitlist input.kt-waitlist__input {\n    box-sizing: border-box;\n    width: 100%;\n    height: 55px;\n    padding: 0 1.375rem;\n    border: 2px solid var(--kt-ink) !important;\n    border-radius: 100px !important;\n    background: #FFFFFF !important;\n    box-shadow: none !important;\n    color: var(--kt-ink);\n    font-family: var(--kt-font);\n    font-size: var(--kt-type-button);\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 400;\n    outline: none;\n  }\n  .kt-waitlist__input::placeholder {\n    color: #9A7555;\n  }\n  .kt-waitlist input.kt-waitlist__input:focus {\n    border-color: #51B18C !important;\n  }\n  .kt-waitlist input.kt-waitlist__input.has-error {\n    border-color: #FF0004 !important;\n  }\n  .kt-waitlist__button {\n    width: 100%;\n    height: 55px;\n    border: 0;\n    border-radius: 100px;\n    background: #51B18C;\n    color: var(--kt-bg);\n    font-family: var(--kt-font);\n    font-size: var(--kt-type-button);\n    font-weight: 700;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n    cursor: pointer;\n    transition: background-color 0.18s ease;\n  }\n  .kt-waitlist__button:hover {\n    background: var(--kt-blue);\n  }\n  .kt-waitlist__button:disabled {\n    opacity: 0.6;\n    cursor: default;\n  }\n  .kt-waitlist__msg {\n    margin: 0;\n    min-height: 1rem;\n    color: var(--kt-ink);\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n  .kt-waitlist__msg.is-error {\n    color: #FF0004;\n  }\n  .kt-waitlist.is-success .kt-waitlist__form {\n    display: none;\n  }\n  .kt-waitlist__done {\n    display: none;\n    margin: 1.375rem 0 0;\n    color: var(--kt-ink);\n    font-family: 'Instrument Sans', sans-serif;\n    font-size: var(--kt-type-b1);\n    line-height: var(--kt-leading-b1);\n    font-weight: 700;\n  }\n  .kt-waitlist.is-success .kt-waitlist__done {\n    display: block;\n  }\n</style>\n\n<div class=\"kt-waitlist\" data-kt-waitlist>\n  <span class=\"kt-waitlist__pill\">{{ kt_status }}</span>\n\n  {%- if kt_status == 'Coming Soon' -%}\n    <p class=\"kt-waitlist__heading\">You got here early!</p>\n    <p class=\"kt-waitlist__body\">We're still dusting and not quite ready but happy you're here! Leave your email and we'll let you know when it goes live.</p>\n  {%- else -%}\n    <p class=\"kt-waitlist__heading\">Well, you have great taste.</p>\n    <p class=\"kt-waitlist__body\">This color is gone for now. Leave your email and we'll let you know when it's back. Can't wait? Take a peek at the other colors below.</p>\n  {%- endif -%}\n\n  <form class=\"kt-waitlist__form\" novalidate>\n    <input class=\"kt-waitlist__input\" type=\"email\" name=\"email\" placeholder=\"Email*\" autocomplete=\"email\" required aria-label=\"Email\">\n    <button class=\"kt-waitlist__button\" type=\"submit\">\n      {%- if kt_status == 'Coming Soon' -%}Keep me in the loop{%- else -%}Tell me when it's back!{%- endif -%}\n    </button>\n    <p class=\"kt-waitlist__msg\" aria-live=\"polite\"></p>\n  </form>\n  <p class=\"kt-waitlist__done\" aria-live=\"polite\">You're on the list! We'll email you as soon as it's ready.</p>\n</div>\n\n<script>\n  (() => {\n    // Waitlist endpoint (Google Apps Script web app → \"Waitlist\" tab of the\n    // \"KT_Contact Rolodex\" workbook; also emails a notification per signup).\n    const WAITLIST_URL = 'https://script.google.com/macros/s/AKfycbzfaUU_H7nVj6Xz_mUy2tCIvkaDfkN26kQ7i59UlnkgRZ_rqdrK9f5RZukGINHGgkOM5A/exec';\n\n    const root = document.querySelector('[data-kt-waitlist]');\n    if (!root) return;\n    const form = root.querySelector('form');\n    const input = form.querySelector('input[name=\"email\"]');\n    const button = form.querySelector('button');\n    const msg = form.querySelector('.kt-waitlist__msg');\n\n    // Single-variant products report \"Default Title\" — store that as blank.\n    const variants = { {%- for v in product.variants -%}\"{{ v.id }}\": {%- if v.title == 'Default Title' -%}\"\"{%- else -%}{{ v.title | json }}{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} };\n    const defaultVariant = \"{{ product.selected_or_first_available_variant.id }}\";\n    // Variant column = the colour shown under the title (e.g. \"Wasabi\"), plus the\n    // Shopify variant name if the product has real variants (e.g. a size).\n    const currentVariantTitle = () => {\n      const id = new URLSearchParams(location.search).get('variant') || defaultVariant;\n      const colorEl = document.querySelector('.kt-product-color');\n      const color = colorEl ? colorEl.textContent.trim() : '';\n      const variant = variants[id] || '';\n      return [color, variant].filter((v, i, all) => v && all.indexOf(v) === i).join(' / ');\n    };\n\n    const showError = (text) => {\n      msg.textContent = text;\n      msg.classList.add('is-error');\n      input.classList.add('has-error');\n    };\n\n    input.addEventListener('input', () => {\n      msg.textContent = '';\n      msg.classList.remove('is-error');\n      input.classList.remove('has-error');\n    });\n\n    form.addEventListener('submit', (e) => {\n      e.preventDefault();\n      const email = input.value.trim();\n      if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n        showError('Please enter a valid email.');\n        return;\n      }\n      if (!WAITLIST_URL) {\n        showError('Waitlist is not connected yet.');\n        return;\n      }\n      // Apps Script can take ~20s to answer, so show success straight away\n      // (same as the footer mailing list) and let the request finish in the\n      // background. keepalive lets it complete even if the visitor leaves.\n      // The form hides on success, so it can't be submitted twice.\n      button.disabled = true;\n      root.classList.add('is-success');\n      fetch(WAITLIST_URL, {\n        method: 'POST',\n        mode: 'no-cors',\n        keepalive: true,\n        body: new URLSearchParams({\n          email,\n          status: {{ kt_status | json }},\n          product: {{ product.title | json }},\n          handle: {{ product.handle | json }},\n          variant: currentVariantTitle(),\n        }),\n      }).catch((err) => console.error('Waitlist signup failed to send', err));\n    });\n  })();\n</script>\n{%- endif -%}"
              },
              "blocks": {}
            },
