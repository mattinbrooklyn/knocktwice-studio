    "custom_liquid_PErLxU": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* Shared chevron arrows (Figma: Carrot_Left / Carrot_Right, 10x20, 2px stroke) */\n  .kt-gallery-arrow {\n    position: absolute;\n    top: var(--kt-arrow-top, 50%);\n    z-index: 5;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: #F7F2EC;\n    transform: translateY(-50%);\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n    transition: color 200ms ease;\n  }\n\n  .kt-gallery-arrow svg {\n    display: block;\n    width: 10px;\n    height: 20px;\n  }\n\n  .kt-gallery-arrow--prev { left: 3px; }\n  .kt-gallery-arrow--next { right: 3px; }\n\n  .kt-gallery-arrow.is-on-light {\n    color: #32261F;\n  }\n\n  .kt-gallery-arrow:focus-visible {\n    outline: 2px solid #378CDA;\n    outline-offset: -6px;\n    border-radius: 6px;\n  }\n\n  /* \"Also Nice\" carousel — arrows on every screen size */\n  [id*=\"product_recommendations\"] .resource-list__carousel > slideshow-container {\n    position: relative;\n  }\n\n  /* Hide Horizon's own black round arrows on the Also Nice carousel */\n  [id*=\"product_recommendations\"] .resource-list__carousel > slideshow-container > slideshow-arrows {\n    display: none;\n  }\n\n  /* Product image gallery — arrows only where it is a swipe slideshow */\n  .kt-arrow--gallery {\n    display: none;\n  }\n\n  @media screen and (max-width: 749px) {\n    media-gallery slideshow-container {\n      position: relative;\n    }\n\n    .kt-arrow--gallery {\n      display: flex;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .kt-gallery-arrow { transition: none; }\n  }\n\n  /* Gallery dots — Figma: 10x10, off-white fill, 2px chocolate stroke */\n  media-gallery slideshow-controls:has(.slideshow-controls__dots) {\n    mix-blend-mode: normal;\n  }\n\n  media-gallery .slideshow-controls__dots {\n    gap: 7.33px;\n  }\n\n  media-gallery .slideshow-controls__dots button {\n    --size: 10px;\n  }\n\n  media-gallery .slideshow-controls__dots button::after,\n  media-gallery .slideshow-controls__dots button:hover::after {\n    box-sizing: border-box;\n    background-color: #F7F2EC;\n    border: 2px solid #32261F;\n    box-shadow: none;\n    opacity: 0.5;\n  }\n\n  media-gallery .slideshow-controls__dots button[aria-selected=\"true\"]::after {\n    opacity: 1;\n  }\n</style>\n\n<script>\n  (function () {\n    var OFF_WHITE = [247, 242, 236];\n    var CHOCOLATE = [50, 38, 31];\n    var cache = {};\n\n    function channel(c) {\n      c = c / 255;\n      return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);\n    }\n\n    function luminance(rgb) {\n      return 0.2126 * channel(rgb[0]) + 0.7152 * channel(rgb[1]) + 0.0722 * channel(rgb[2]);\n    }\n\n    function contrast(a, b) {\n      var hi = Math.max(a, b), lo = Math.min(a, b);\n      return (hi + 0.05) / (lo + 0.05);\n    }\n\n    var L_OFF = luminance(OFF_WHITE);\n    var L_INK = luminance(CHOCOLATE);\n\n    // Average colour of the strip of an image that sits behind one arrow.\n    // Resolves to true when chocolate reads better than off-white there.\n    function isLightBehind(src, side) {\n      var key = src + '|' + side;\n      if (key in cache) return Promise.resolve(cache[key]);\n\n      return new Promise(function (resolve) {\n        var url;\n        try {\n          url = new URL(src, location.href);\n          url.searchParams.set('width', '80');\n        } catch (e) {\n          resolve(false);\n          return;\n        }\n\n        var img = new Image();\n        img.crossOrigin = 'anonymous';\n        var timer = setTimeout(function () { resolve(false); }, 6000);\n\n        img.onload = function () {\n          clearTimeout(timer);\n          try {\n            var canvas = document.createElement('canvas');\n            canvas.width = img.naturalWidth;\n            canvas.height = img.naturalHeight;\n            var ctx = canvas.getContext('2d');\n            ctx.drawImage(img, 0, 0);\n\n            var w = canvas.width, h = canvas.height;\n            var sw = Math.max(1, Math.round(w * 0.14));\n            var sx = side === 'prev' ? 0 : w - sw;\n            var sy = Math.round(h * 0.4);\n            var sh = Math.max(1, Math.round(h * 0.2));\n            var data = ctx.getImageData(sx, sy, sw, sh).data;\n\n            var r = 0, g = 0, b = 0, n = 0;\n            for (var i = 0; i < data.length; i += 4) {\n              r += data[i]; g += data[i + 1]; b += data[i + 2]; n++;\n            }\n            var bg = luminance([r / n, g / n, b / n]);\n            var light = contrast(bg, L_INK) > contrast(bg, L_OFF);\n            cache[key] = light;\n            resolve(light);\n          } catch (e) {\n            resolve(false);\n          }\n        };\n\n        img.onerror = function () {\n          clearTimeout(timer);\n          resolve(false);\n        };\n\n        img.src = url.href;\n      });\n    }\n\n    function chevron(direction) {\n      var d = direction === 'prev' ? 'M9 1L1 10L9 19' : 'M1 1L9 10L1 19';\n      return '<svg viewBox=\"0 0 10 20\" fill=\"none\" aria-hidden=\"true\">' +\n        '<path d=\"' + d + '\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>' +\n        '</svg>';\n    }\n\n    function makeArrows(container, kind, prevLabel, nextLabel) {\n      var prev = document.createElement('button');\n      prev.type = 'button';\n      prev.className = 'kt-gallery-arrow kt-gallery-arrow--prev kt-arrow--' + kind;\n      prev.setAttribute('aria-label', prevLabel);\n      prev.innerHTML = chevron('prev');\n\n      var next = document.createElement('button');\n      next.type = 'button';\n      next.className = 'kt-gallery-arrow kt-gallery-arrow--next kt-arrow--' + kind;\n      next.setAttribute('aria-label', nextLabel);\n      next.innerHTML = chevron('next');\n\n      container.appendChild(prev);\n      container.appendChild(next);\n      return { prev: prev, next: next };\n    }\n\n    function tint(button, src, side) {\n      if (!src) return;\n      isLightBehind(src, side).then(function (light) {\n        button.classList.toggle('is-on-light', light);\n      });\n    }\n\n    function onScrollEnd(scroller, callback) {\n      var t;\n      scroller.addEventListener('scroll', function () {\n        clearTimeout(t);\n        t = setTimeout(callback, 150);\n      }, { passive: true });\n      scroller.addEventListener('scrollend', callback);\n    }\n\n    /* ── Product image gallery ─────────────────────────── */\n    function setupGallery(gallery) {\n      var show = gallery.querySelector('slideshow-component');\n      if (!show || show.dataset.ktArrows) return;\n\n      var slides = show.querySelectorAll('slideshow-slide');\n      if (slides.length < 2) return;\n\n      var container = show.querySelector('slideshow-container') || show;\n      show.dataset.ktArrows = '1';\n      var arrows = makeArrows(container, 'gallery', 'Previous image', 'Next image');\n\n      function refresh() {\n        var i = Number(show.current);\n        var slide = show.querySelectorAll('slideshow-slide')[isNaN(i) ? 0 : i];\n        var img = slide && slide.querySelector('img');\n        var src = img && (img.currentSrc || img.src);\n        tint(arrows.prev, src, 'prev');\n        tint(arrows.next, src, 'next');\n      }\n\n      arrows.prev.addEventListener('click', function () {\n        if (typeof show.previous === 'function') show.previous();\n        setTimeout(refresh, 350);\n      });\n\n      arrows.next.addEventListener('click', function () {\n        if (typeof show.next === 'function') show.next();\n        setTimeout(refresh, 350);\n      });\n\n      var scroller = show.querySelector('slideshow-slides');\n      if (scroller) onScrollEnd(scroller, refresh);\n\n      refresh();\n    }\n\n    /* ── \"Also Nice\" recommendations carousel ──────────── */\n    function setupCarousel(section) {\n      var show = section.querySelector('slideshow-component.resource-list__carousel');\n      if (!show || show.dataset.ktArrows) return;\n\n      var cards = show.querySelectorAll('.resource-list__slide');\n      var scroller = show.querySelector('slideshow-slides');\n      var container = show.querySelector(':scope > slideshow-container');\n      if (cards.length < 3 || !scroller || !container) return;\n\n      show.dataset.ktArrows = '1';\n      var arrows = makeArrows(container, 'carousel', 'Previous product', 'Next product');\n      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n      function step() {\n        return cards[0].getBoundingClientRect().width;\n      }\n\n      function go(direction) {\n        var max = scroller.scrollWidth - scroller.clientWidth;\n        var target = scroller.scrollLeft + direction * step();\n\n        // Move one card, stop at the end, and only loop once already at the end\n        if (direction > 0) {\n          target = scroller.scrollLeft >= max - 1 ? 0 : Math.min(target, max);\n        } else {\n          target = scroller.scrollLeft <= 1 ? max : Math.max(target, 0);\n        }\n\n        scroller.scrollTo({ left: target, behavior: reduceMotion ? 'auto' : 'smooth' });\n        setTimeout(refresh, 450);\n      }\n\n      // The card whose image sits under a given arrow\n      function cardUnder(button) {\n        var b = button.getBoundingClientRect();\n        var x = b.left + b.width / 2;\n        for (var i = 0; i < cards.length; i++) {\n          var r = cards[i].getBoundingClientRect();\n          if (x >= r.left && x <= r.right) return cards[i];\n        }\n        return null;\n      }\n\n      function imageSrc(card) {\n        var img = card && card.querySelector('.card-gallery img');\n        return img && (img.currentSrc || img.src);\n      }\n\n      function refresh() {\n        // Sit the arrows on the middle of the product images, not the whole card\n        var gallery = cards[0].querySelector('.card-gallery');\n        if (gallery) {\n          var top = gallery.getBoundingClientRect().top - container.getBoundingClientRect().top;\n          container.style.setProperty('--kt-arrow-top', (top + gallery.offsetHeight / 2) + 'px');\n        }\n\n        tint(arrows.prev, imageSrc(cardUnder(arrows.prev)), 'prev');\n        tint(arrows.next, imageSrc(cardUnder(arrows.next)), 'next');\n      }\n\n      arrows.prev.addEventListener('click', function () { go(-1); });\n      arrows.next.addEventListener('click', function () { go(1); });\n      onScrollEnd(scroller, refresh);\n      window.addEventListener('resize', refresh);\n\n      refresh();\n    }\n\n    function init() {\n      document.querySelectorAll('media-gallery').forEach(setupGallery);\n      document.querySelectorAll('product-recommendations').forEach(setupCarousel);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', init);\n    } else {\n      init();\n    }\n\n    // Recommendations arrive later over the network\n    new MutationObserver(function () {\n      document.querySelectorAll('product-recommendations').forEach(setupCarousel);\n    }).observe(document.body, { childList: true, subtree: true });\n\n    document.addEventListener('shopify:section:load', init);\n  })();\n</script>",
