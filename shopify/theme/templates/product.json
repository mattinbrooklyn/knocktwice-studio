    "custom_liquid_rbwPDn": {
      "type": "custom-liquid",
      "name": "images height miss aligned",
      "settings": {
        "custom_liquid": "<style>\n  /* \"Also Nice\" carousel: the first card had an extra left border inside its\n     width (border-box), so its image was ~1.6px narrower and, being\n     aspect-ratio sized, ~1.25px shorter than the others. Draw that left line\n     with ::before instead so every card's image is the same size. */\n  [id*=\"product_recommendations\"] product-recommendations .resource-list__slide:first-child .product-card__content {\n    border-left-width: 0 !important;\n    position: relative;\n  }\n  [id*=\"product_recommendations\"] product-recommendations .resource-list__slide:first-child .product-card__content::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 0;\n    width: 2px;\n    background: #32261F;\n    z-index: 2;\n    pointer-events: none;\n  }\n</style>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
