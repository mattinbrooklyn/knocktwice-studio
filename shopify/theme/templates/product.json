              "settings": {
                "custom_liquid": "<style>\n[id*=\"product_recommendations\"] .product-card__content {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  column-gap: 12px;\n  row-gap: 4px;\n  align-items: start;          /* baseline ki jagah */\n}\n\n[id*=\"product_recommendations\"] .product-card__content > .card-gallery {\n  grid-column: 1 / -1;\n  align-self: stretch;\n  margin: 0;\n}\n\n/* Baseline sirf naam aur price ke darmiyan */\n[id*=\"product_recommendations\"] .product-card__content > a,\n[id*=\"product_recommendations\"] .product-card__content > product-price {\n  align-self: baseline;\n}\n\n[id*=\"product_recommendations\"] .product-card__content > product-price {\n  justify-self: end;\n  text-align: right;\n  width: auto;\n}\n\n[id*=\"product_recommendations\"] .product-card__content > div:not([class]) {\n  display: none;\n}\n\n/* Card ka quick add button */\nquick-add-component,\n.quick-add {\n  display: none;\n}\n\n/* Neeche chipakne wali add to cart bar */\nsticky-add-to-cart,\n.sticky-add-to-cart {\n  display: none;\n}\n\nbody [class*=\"color-custom-template--\"],\nbody [class*=\"color-custom-template--\"] .text-block {\n  --color: #32261F;\n  --color-foreground: #32261F;\n}\n\n[id*=\"product_recommendations\"] product-price,\n[id*=\"product_recommendations\"] product-price .price {\n  font-family: 'Instrument Sans', sans-serif !important;\n  font-size: 14px;\n  font-weight: 700;\n  color: #32261F;\n}\n</style>"
