    "custom_liquid_Bdr4nM": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  html:root,\n  .color-custom-badge-sale,\n  .color-custom-badge-sold-out,\n  .color-custom-drawer,\n  .color-custom-popover,\n  [class*=\"color-custom-template--\"] {\n    --color: #32261F;\n    --color-foreground: #32261F;\n    --color-border: #32261F;\n    --color-rgb: 50 38 31;\n    --color-foreground-rgb: 50 38 31;\n    --color-border-rgb: 50 38 31;\n  }\n\n  html:root {\n    --palette-darkest: #32261F;\n    --color-variant-text-rgb: 50 38 31;\n  }\n\n  .custom-color-quick-add {\n    --quick-add-foreground: #32261F;\n  }\n\n\n@media screen and (max-width: 749px) {\n  /* Two products per view */\n  [id*=\"product_recommendations\"] .resource-list__carousel .resource-list__slide {\n    --slide-width: 50cqw;\n  }\n\n  /* Square image, as in Figma (223x221) */\n  [id*=\"product_recommendations\"] .card-gallery {\n    --gallery-aspect-ratio: calc(223 / 221) !important;\n  }\n\n  /* Name above price */\n  [id*=\"product_recommendations\"] .product-card__content {\n    grid-template-columns: 1fr;\n    row-gap: 0;\n    padding-bottom: 10px;\n  }\n\n  [id*=\"product_recommendations\"] .product-card__content a .text-block {\n    padding: 13px 20px 0;\n  }\n\n  [id*=\"product_recommendations\"] .product-card__content a .text-block p {\n    font-size: 12px;\n    line-height: 17px;\n    font-weight: 400;\n  }\n\n  [id*=\"product_recommendations\"] .product-card__content > product-price {\n    justify-self: start;\n    text-align: left;\n    padding: 2px 20px 0;\n  }\n\n  [id*=\"product_recommendations\"] product-price .price {\n    font-size: 12px;\n    line-height: 17px;\n    font-weight: 700;\n  }\n}\n</style>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_d6w7zw": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* Knock Twice global type scale — same values as the main site's\n     assets/styles.css, so Shopify pages match the rest of the site. */\n  :root {\n    --kt-type-h2:        clamp(1.625rem, 3.13vw, 1.875rem);   /* 26 → 30 */\n    --kt-leading-h2:     clamp(1.8125rem, 3.18vw, 2.0625rem); /* 29 → 33 */\n    --kt-type-nav:       clamp(1.375rem, 2.13vw, 1.625rem);   /* 22 → 26 */\n    --kt-leading-nav:    clamp(1.6875rem, 2.22vw, 1.875rem);  /* 27 → 30 */\n    --kt-type-b1:        clamp(1rem, 1.54vw, 1.125rem);       /* 16 → 18 */\n    --kt-leading-b1:     clamp(1.375rem, 1.96vw, 1.5rem);     /* 22 → 24 */\n    --kt-type-button:    clamp(1rem, 1.3vw, 1.125rem);        /* 16 → 18 */\n    --kt-leading-button: clamp(1.375rem, 1.6vw, 1.4375rem);   /* 22 → 23 */\n\n    --kt-type-h1:    clamp(2.875rem, 5.23vw, 4.25rem);  /* 46 → 68 */\n    --kt-leading-h1: clamp(3rem, 5.35vw, 4.375rem);     /* 48 → 70 */\n  }\n\n    .kt-product-title {\n    font-size: var(--kt-type-h1);\n    line-height: var(--kt-leading-h1);\n  }\n\n  .kt-product-color,\n  .kt-product-price {\n    font-size: var(--kt-type-nav);\n    line-height: var(--kt-leading-nav);\n  }\n\n  .kt-product-description,\n  .kt-product-description p,\n  .kt-upload__heading,\n  .kt-upload__body,\n  .kt-upload__file,\n  .kt-qty__label {\n    font-size: var(--kt-type-b1);\n    line-height: var(--kt-leading-b1);\n  }\n\n  accordion-custom details.details > summary.details__header {\n    font-size: var(--kt-type-b1);\n    line-height: var(--kt-leading-b1);\n  }\n\n  .kt-upload__text,\n  .kt-qty__input,\n  .add-to-cart-text,\n  .add-to-cart-text__content {\n    font-size: var(--kt-type-button);\n    line-height: var(--kt-leading-button);\n  }\n\n  /* Mobile: replaces the old fixed 30px / 22px sizes */\n  @media screen and (max-width: 749px) {\n    .kt-product-title { font-size: var(--kt-type-h1); }\n    .kt-product-price { font-size: var(--kt-type-nav); }\n  }\n\n  /* (3) Remove the cart icon from the Add to Cart button */\n  .add-to-cart-text .svg-wrapper {\n    display: none;\n  }\n</style>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
