                "custom_liquid": "<style>\n  button.add-to-cart-button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    height: 55px;\n    padding: 0 20px;\n    border: none;\n    border-radius: 100px;\n    background: #51B18C;\n    color: #F7F2EC;\n    font-family: 'Handjet', sans-serif;\n    font-size: 16px;\n    line-height: 22px;\n    font-weight: 700;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n    letter-spacing: 0;\n    text-align: center;\n    cursor: pointer;\n    transition: opacity 120ms ease;\n  }\n\n  button.add-to-cart-button:hover {\n    opacity: 0.9;\n  }\n\n  button.add-to-cart-button:focus-visible {\n    outline: 2px solid #378CDA;\n    outline-offset: 2px;\n  }\n\n  button.add-to-cart-button[disabled] {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    button.add-to-cart-button { transition: none; }\n  }\n</style>"
