ver a cached answer\n    const refresh = () =>\n      fetch('/cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' })\n        .then((r) => r.json())\n        .then((cart) => render(cart.item_count))\n        .catch(() => {});\n\n    // Whenever the theme adds/changes/removes cart items, refresh the count\n    const originalFetch = window.fetch;\n    window.fetch = function (...args) {\n      const url = String(args[0] && args[0].url ? args[0].url : args[0]);\n      const request = originalFetch.apply(this, args);\n      if (/\\/cart\\/(add|change|update|clear)/.test(url)) {\n        request.then(() => refresh()).catch(() => {});\n      }\n      return request;\n    };\n\n    // Coming back to this page with the Back button (the browser may show\n    // the page exactly as it was left, old count included), or returning to\n    // this tab after changing the cart somewhere else: refresh the count\n    window.addEventListener('pageshow', refresh);\n    document.addEventListener('visibilitychange', () => {\n      if (document.visibilityState === 'visible') refresh();\n    });\n\n    refresh();\n  })();\n</script>\n\n<style>\n  :root {\n    --kt-bg: #F7F2EC;\n    --kt-ink: #32261F;\n    --kt-blue: #378CDA;\n    --kt-font: 'Handjet', sans-serif;\n  }\n\n  .kt-menu-toggle {\n    display: none;\n  }\n\n  .kt-logo svg path {\n    transition: fill 0.2s ease;\n  }\n\n  .kt-logo:hover svg path,\n  .kt-logo:active svg path {\n    fill: var(--kt-ink);\n  }\n\n  .kt-logo:hover svg path.logo-eye-sclera,\n  .kt-logo:active svg path.logo-eye-sclera {\n    fill: var(--kt-bg);\n  }\n\n  .kt-nav a {\n    color: var(--kt-ink);\n    text-decoration: none;\n    font-family: var(--kt-font);\n    font-size: 1.375rem;\n    font-weight: 400;\n    line-height: 1.6875rem;\n    letter-spacing: -0.01375rem;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 400;\n  }\n\n  .kt-nav a.active,\n  .kt-nav a:hover {\n    color: var(--kt-blue);\n    font-weight: 700;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n  }\n\n  .kt-cart-button {\n    position: fixed;\n    right: 0;\n    z-index: 1300;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--kt-ink);\n    background: var(--kt-bg);\n    border: 2px solid var(--kt-ink);\n    border-right: 0;\n    border-radius: 999px 0 0 999px;\n    text-decoration: none;\n  }\n\n  .kt-cart-button:hover {\n    background: var(--kt-ink);\n    color: var(--kt-bg);\n  }\n\n  .kt-cart-count {\n    position: absolute;\n    min-width: 1.15rem;\n    height: 1.15rem;\n    padding: 0 0.25rem;\n    border-radius: 999px;\n    background: var(--kt-blue);\n    color: #fff;\n    font-size: 0.7rem;\n    line-height: 1.15rem;\n    text-align: center;\n    font-weight: 700;\n  }\n\n  @media screen and (min-width: 990px) {\n    .kt-side-nav-section {\n      height: 0 !important;\n      min-height: 0 !important;\n      margin: 0 !important;\n      padding: 0 !important;\n      overflow: visible !important;\n    }\n\n    body.kt-has-custom-nav {\n      background: var(--kt-bg) !important;\n    }\n\n    body.kt-has-custom-nav main {\n      padding-left: 210px !important;\n      box-sizing: border-box !important;\n      background: var(--kt-bg) !important;\n    }\n\n    .kt-nav-shell {\n      position: fixed;\n      left: 2.5rem;\n      top: 3.8rem;\n      z-index: 1200;\n      width: 7rem;\n    }\n\n    .kt-logo {\n      display: block;\n      width: 3.25rem;\n      height: 6.25rem;\n      margin-bottom: 4.2rem;\n    }\n\n    .kt-menu-button {\n      display: none;\n    }\n\n    .kt-nav {\n      display: flex;\n      flex-direction: column;\n      gap: 0.5rem;\n    }\n\n    .kt-cart-button {\n      top: 3.8rem;\n      width: 5.5rem;\n      height: 3.75rem;\n    }\n\n    .kt-cart-count {\n      top: 0.35rem;\n      right: 0.65rem;\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n  .kt-side-nav-section {\n    height: 0 !important;\n    min-height: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: visible !important;\n  }\n\n  body.kt-has-custom-nav main {\n    padding-left: 0 !important;\n    padding-top: 97px !important;\n    box-sizing: border-box !important;\n    background: var(--kt-bg) !important;\n  }\n\n  .kt-nav-shell {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 1200;\n    height: 97px;\n    background: var(--kt-bg);\n  }\n\n  /* Logo — center, acts as home */\n  .kt-logo {\n    position: absolute;\n    top: 30px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 25px;\n    height: 47px;\n  }\n\n  /* Hamburger pill — left edge, flat side against the edge */\n  .kt-menu-button {\n    position: absolute;\n    top: 30px;\n    left: 0;\n    width: 76px;\n    height: 47px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n    background: var(--kt-bg);\n    color: var(--kt-ink);\n    border: 2px solid var(--kt-ink);\n    border-left: 0;\n    border-radius: 0 23.5px 23.5px 0;\n    cursor: pointer;\n    user-select: none;\n  }\n\n  .kt-menu-icon {\n    display: block;\n    width: 34px;\n    height: 20px;\n  }\n\n  /* Keep \"Menu\" for screen readers only */\n  .kt-menu-text {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip-path: inset(50%);\n    white-space: nowrap;\n  }\n\n  .kt-nav {\n    position: absolute;\n    top: 97px;\n    left: 0;\n    right: 0;\n    display: none;\n    flex-direction: column;\n    background: var(--kt-bg);\n    border-bottom: 1px solid rgba(50, 38, 31, 0.18);\n    padding: 14px 18px 18px;\n    box-sizing: border-box;\n  }\n\n  .kt-nav a {\n    display: block;\n    padding: 8px 0;\n    font-size: 1.45rem;\n    line-height: 1.35rem;\n  }\n\n  .kt-menu-toggle:checked ~ .kt-nav {\n    display: flex;\n  }\n\n  /* Cart pill — right edge, mirror of the menu pill */\n  .kt-cart-button {\n    top: 30px;\n    right: 0;\n    width: 76px;\n    height: 47px;\n    box-sizing: border-box;\n    border-width: 2px;\n    border-right: 0;\n    border-radius: 23.5px 0 0 23.5px;\n    z-index: 1400;\n  }\n\n  .kt-cart-button svg {\n    width: 27px;\n    height: 26px;\n  }\n\n  .kt-cart-count {\n    top: 0.3rem;\n    right: 0.6rem;\n    min-width: 1rem;\n    height: 1rem;\n    font-size: 0.65rem;\n    line-height: 1rem;\n  }\n}\n\n  /* Mobile menu: full-screen overlay, same as the main site (spec No. 15) */\n  .kt-nav-shell .kt-menu-close { display: none; }\n\n  @media screen and (max-width: 989px) {\n    .kt-nav-shell:has(.kt-menu-toggle:checked) { z-index: 10000; }\n    body:has(.kt-menu-toggle:checked) { overflow: hidden; }\n\n    .kt-nav-shell .kt-nav {\n      position: fixed;\n      inset: 0;\n      z-index: 1;\n      height: 100vh;\n      height: 100dvh;\n      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)\n               env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);\n      background: #EC8EDF;\n      border-bottom: 0;\n      overscroll-behavior: none;\n    }\n    .kt-nav-shell .kt-nav a {\n      flex: 1 1 0;\n      min-height: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 0 1rem;\n      border-top: 1px solid var(--kt-ink);\n      font-size: 2.125rem;\n      line-height: 1.12;\n      letter-spacing: -0.02125rem;\n      text-transform: uppercase;\n      text-align: center;\n    }\n    .kt-nav-shell .kt-nav a:last-of-type { border-bottom: 1px solid var(--kt-ink); }\n    .kt-nav-shell .kt-nav a.active,\n    .kt-nav-shell .kt-nav a:hover {\n      color: var(--kt-ink);\n      background: #FADB4B;\n    }\n\n    .kt-nav-shell .kt-menu-close {\n      display: flex;\n      position: absolute;\n      top: 1.875rem;\n      right: 1.625rem;\n      z-index: 1;\n      width: 2.75rem;\n      height: 2.75rem;\n      align-items: flex-start;\n      justify-content: flex-end;\n      color: var(--kt-ink);\n      cursor: pointer;\n    }\n    .kt-nav-shell .kt-menu-close svg { width: 0.9375rem; height: 0.9375rem; display: block; }\n  }\n\n  /* Cart button: blue pressed state, badge turns chocolate (spec No. 16) */\n  .kt-cart-button:hover,\n  .kt-cart-button:active {\n    background: var(--kt-blue);\n    color: var(--kt-bg);\n  }\n  .kt-cart-button:hover .kt-cart-count,\n  .kt-cart-button:active .kt-cart-count {\n    background: var(--kt-ink);\n    color: var(--kt-bg);\n  }\n\n  /* Cart button: bigger icon + badge overlapping it on mobile (spec No. 16) */\n  @media screen and (max-width: 989px) {\n    .kt-cart-button svg.kt-cart-svg {\n      width: 44px;\n      height: 44px;\n      margin: -4px 0 0 2px;\n    }\n    .kt-cart-button svg path,\n    .kt-cart-button svg circle {\n      vector-effect: non-scaling-stroke;\n    }\n    .kt-cart-button .kt-cart-count {\n      top: 4px;\n      right: 12px;\n      min-width: 14px;\n      height: 14px;\n      padding: 0 3px;\n      font-size: 9px;\n      line-height: 14px;\n      box-sizing: border-box;\n    }\n  }\n  /* Cart button: bigger icon + badge next to it on desktop (spec No. 16) */\n  @media screen and (min-width: 990px) {\n    .kt-cart-button svg.kt-cart-svg {\n      width: 52px;\n      height: 52px;\n      margin: -5px 0 0 3px;\n    }\n    .kt-cart-button svg path,\n    .kt-cart-button svg circle {\n      vector-effect: non-scaling-stroke;\n    }\n    .kt-cart-button .kt-cart-count {\n      top: 4px;\n      right: 12px;\n      min-width: 18px;\n      height: 18px;\n      padding: 0 4px;\n      font-size: 10px;\n      line-height: 16px;\n      box-sizing: border-box;\n    }\n  }\n  /* ── Match the native side nav (assets/styles.css .logo / .nav) ── */\n  @media screen and (min-width: 990px) {\n    .kt-nav-shell {\n      top: 3.8125rem;                 /* --logo-top: 61px */\n    }\n    .kt-logo {\n      /* Menu starts at --nav-top (200px): 200 − 61 logo top − 100 logo */\n      margin-bottom: calc(12.5rem - 3.8125rem - 6.25rem);\n    }\n    .kt-nav a {\n      font-size: clamp(1.375rem, 2.13vw, 1.625rem);     /* --type-nav: 22 → 26 */\n      line-height: clamp(1.6875rem, 2.22vw, 1.875rem);  /* --leading-nav: 27 → 30 */\n      letter-spacing: -0.01375rem;                      /* --tracking-nav */\n    }\n    /* Current page: bold chocolate, like native. Blue is hover only. */\n    .kt-nav a.active {\n      color: var(--kt-ink);\n    }\n    .kt-nav a:hover {\n      color: var(--kt-blue);\n    }\n  }\n  /* Cart icon: Figma artwork, centred in the pill at the Figma proportion\n     (icon height ≈ 71% of the pill height) */\n  .kt-cart-button svg.kt-cart-svg { margin: 0 !important; }\n  @media screen and (max-width: 989px) {\n    .kt-cart-button svg.kt-cart-svg { width: 35px !important; height: 33.3px !important; }\n  }\n  @media screen and (min-width: 990px) {\n    .kt-cart-button svg.kt-cart-svg { width: 40px !important; height: 40px !important; }\n  }\n</style>\n\n<script>\n  document.body.classList.add('kt-has-custom-nav');\n\n  const currentScript = document.currentScript;\n  const section = currentScript.closest('.shopify-section');\n\n  if (section) {\n    section.classList.add('kt-side-nav-section');\n  }\n</script>",
