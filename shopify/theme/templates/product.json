            "custom_liquid_xxWFHP": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n/* Product page \"Tell Me More\" / \"Shipping & Stuff\": match FAQ dropdowns (spec No. 10) */\ndetails[data-kt-single-accordion] > summary.details__header {\n  font-weight: 800 !important;\n  font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 500;\n  transition: color 0.18s ease;\n}\ndetails[data-kt-single-accordion][open] > summary.details__header {\n  font-weight: 700 !important;\n  font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n}\n@media (hover: hover) {\n  details[data-kt-single-accordion] > summary.details__header:hover {\n    color: var(--color-blue);\n  }\n}\ndetails[data-kt-single-accordion] > summary.details__header:focus-visible {\n  color: var(--color-blue);\n}\n\n/* \"Tell Me More\" / \"Shipping & Stuff\": match site type scale + FAQ dropdown sizing */\naccordion-custom details.details[data-kt-single-accordion] > summary.details__header {\n  font-size: var(--kt-type-nav);\n  line-height: var(--kt-leading-nav);\n  padding-block: 0.8125rem;\n}\ndetails.details[data-kt-single-accordion] > summary.details__header .icon-caret {\n  width: 2rem;\n  height: 2rem;\n  margin-block: -0.375rem;\n  margin-right: -0.4375rem;\n}\ndetails.details[data-kt-single-accordion] > summary.details__header .icon-caret svg {\n  width: 100%;\n  height: 100%;\n}\ndetails.details[data-kt-single-accordion] > summary.details__header .icon-caret path {\n  stroke-width: 2px;\n  vector-effect: non-scaling-stroke;\n}\ndetails.details[data-kt-single-accordion] .details-content :is(p, li) {\n  font-size: var(--kt-type-b1);\n  line-height: var(--kt-leading-b1);\n}\n  /* Links inside the product accordions (\"Tell Me More\", \"Shipping & Stuff\")\n     use the site's word-link style: blue, bold, no underline until hover\n     (same as .policy a in assets/policy.css). The text comes from the rich\n     text editor and often wraps the link text in <strong>, which the theme\n     colours separately, so that is pinned too. */\n  .accordion .details-content a {\n    color: #378CDA !important;\n    font-weight: 700 !important;\n    text-decoration: none !important;\n  }\n  .accordion .details-content a:hover {\n    text-decoration: underline !important;\n  }\n  .accordion .details-content a strong,\n  .accordion .details-content a b {\n    color: inherit !important;\n    font-weight: inherit !important;\n  }\n\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    function initSingleOpenAccordions() {\n      const accordionDetails = document.querySelectorAll(\n        'main details, .product details, .product__info-wrapper details, .product__accordion details'\n      );\n\n      accordionDetails.forEach(function (detail) {\n        if (detail.dataset.ktSingleAccordion === 'true') return;\n\n        detail.dataset.ktSingleAccordion = 'true';\n\n        detail.addEventListener('toggle', function () {\n          if (!detail.open) return;\n\n          accordionDetails.forEach(function (otherDetail) {\n            if (otherDetail !== detail) {\n              otherDetail.open = false;\n            }\n          });\n        });\n      });\n    }\n\n    initSingleOpenAccordions();\n\n    document.addEventListener('shopify:section:load', function () {\n      initSingleOpenAccordions();\n    });\n  });\n</script>"
              },
