ortant;\n  }\n\n  body.kt-has-custom-nav main {\n    padding-left: 0 !important;\n    padding-top: 97px !important;\n    box-sizing: border-box !important;\n    background: var(--kt-bg) !important;\n  }\n\n  .kt-nav-shell {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 1200;\n    height: 97px;\n    background: var(--kt-bg);\n  }\n\n  /* Logo — center, acts as home */\n  .kt-logo {\n    position: absolute;\n    top: 30px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 25px;\n    height: 47px;\n  }\n\n  /* Hamburger pill — left edge, flat side against the edge */\n  .kt-menu-button {\n    position: absolute;\n    top: 30px;\n    left: 0;\n    width: 76px;\n    height: 47px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n    background: var(--kt-bg);\n    color: var(--kt-ink);\n    border: 2px solid var(--kt-ink);\n    border-left: 0;\n    border-radius: 0 23.5px 23.5px 0;\n    cursor: pointer;\n    user-select: none;\n  }\n\n  .kt-menu-icon {\n    display: block;\n    width: 34px;\n    height: 20px;\n  }\n\n  /* Keep \"Menu\" for screen readers only */\n  .kt-menu-text {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip-path: inset(50%);\n    white-space: nowrap;\n  }\n\n  .kt-nav {\n    position: absolute;\n    top: 97px;\n    left: 0;\n    right: 0;\n    display: none;\n    flex-direction: column;\n    background: var(--kt-bg);\n    border-bottom: 1px solid rgba(50, 38, 31, 0.18);\n    padding: 14px 18px 18px;\n    box-sizing: border-box;\n  }\n\n  .kt-nav a {\n    display: block;\n    padding: 8px 0;\n    font-size: 1.45rem;\n    line-height: 1.35rem;\n  }\n\n  .kt-menu-toggle:checked ~ .kt-nav {\n    display: flex;\n  }\n\n  /* Cart pill — right edge, mirror of the menu pill */\n  .kt-cart-button {\n    top: 30px;\n    right: 0;\n    width: 76px;\n    height: 47px;\n    box-sizing: border-box;\n    border-width: 2px;\