{%- comment -%}
  Knock Twice — makes the theme's Size dropdown (variant picker, dropdown
  style) look like the Quantity box above it: same bold label, white pill
  with a chocolate stroke, Handjet bold value, chevron on the right.
  Rendered once from blocks/kt-product-meta.liquid.
{%- endcomment -%}
<style>
  .product-details .variant-picker .variant-option--dropdowns {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    margin: 0 0 24px;
    padding: 0;
    border: 0;
  }
  .product-details .variant-picker .variant-option--dropdowns > label {
    margin: 0;
    padding: 0;
    font-family: 'Instrument Sans', sans-serif;
    font-size: var(--kt-type-b1, 16px);
    line-height: var(--kt-leading-b1, 22px);
    font-weight: 700;
    color: #32261F;
    text-transform: none;
    letter-spacing: 0;
  }
  .product-details .variant-picker .variant-option__select-wrapper {
    position: relative;
    width: 100%;
    height: 55px;
    border: 2px solid #32261F;
    border-radius: 100px;
    background: #FFFFFF;
    box-shadow: none;
    overflow: hidden;
  }
  .product-details .variant-picker .variant-option__select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0 56px 0 22px;
    border: 0;
    border-radius: 100px;
    background: transparent;
    color: #32261F;
    font-family: 'Handjet', sans-serif;
    font-size: var(--kt-type-field, 16px);
    font-weight: 700;
    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;
    cursor: pointer;
    outline: none;
  }
  .product-details .variant-picker .variant-option__select-wrapper:focus-within {
    border-color: #51B18C;
  }
  .product-details .variant-picker .variant-option__select-wrapper .icon-caret,
  .product-details .variant-picker .variant-option__select-wrapper svg {
    position: absolute;
    right: 22px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    color: #32261F;
    pointer-events: none;
  }
</style>
