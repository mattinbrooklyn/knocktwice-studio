      "settings": {
        "custom_liquid": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta\n      name=\"viewport\"\n      content=\"width=device-width, initial-scale=1, viewport-fit=cover\"\n    />\n    <title>Knock Twice Footer</title>\n\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Handjet:wght@100..900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Erica+One&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n\n    <style>\n      :root {\n        --color-bg: #f7f2ec;\n        --color-ink: #32261f;\n        --color-blue: #378cda;\n        --color-green: #51b18c;\n        --color-red: #ff0004;\n        --font-ui: \"Handjet\", sans-serif;\n        --font-body: \"Instrument Sans\", sans-serif;\n        --font-display: \"Erica One\", serif;\n        --type-field: 1rem;\n        --type-button: clamp(1rem, 1.3vw, 1.125rem);\n        --type-error: clamp(0.75rem, 1vw, 0.875rem);\n        --leading-error: clamp(1.0625rem, 1.39vw, 1.25rem);\n        --radius-button: 6.25rem;\n        --input-height: 3.4375rem;\n        --button-height: 3.4375rem;\n\n        --content-left-mobile: 1.25rem;\n        /* Footer is now the full panel (links + mailing list + support) */\n        --footer-height: 22.5rem;\n        --footer-height-mobile: 26.875rem;\n        --footer-pad-x: 2.5rem;\n        --wave-height-desktop: 6.875rem;\n        --wave-height-mobile: 4rem;\n      }\n\n      * {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n      }\n\n      body {\n        background: var(--color-bg);\n        min-height: 100vh;\n      }\n\n      .page {\n        position: relative;\n        background: var(--color-bg);\n      }\n\n      /* Wave and footer sit in normal flow, so the panel can grow with its\n         content without the wave drifting away from it. */\n      #monster-group {\n        position: relative;\n        left: 0;\n        width: 100%;\n        z-index: 5;\n        transform: translateY(250px);\n        will-change: transform;\n      }\n\n      #monster-group.popped-up {\n        transform: translateY(0);\n        transition: transform 1800ms cubic-bezier(0.16, 1, 0.3, 1);\n        transition-delay: 1.1s;\n      }\n\n      .monster-area {\n        position: relative;\n        width: 100%;\n        height: var(--wave-height-desktop);\n      }\n\n      .monster-area img.wave {\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        display: block;\n        pointer-events: none;\n      }\n\n      .monster-eyes-overlay {\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        pointer-events: none;\n        overflow: visible;\n      }\n\n      .monster-area .eye-blink-group {\n        transform-box: fill-box;\n        transform-origin: center;\n      }\n\n      .monster-area .eye-blink-group.closing {\n        transform: scaleY(0);\n        transition: transform 60ms ease-in;\n      }\n\n      .monster-area .eye-blink-group.opening {\n        transform: scaleY(1);\n        transition: transform 100ms ease-out;\n      }\n\n      .monster-eyes-overlay-mobile {\n        display: none;\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        pointer-events: none;\n        overflow: visible;\n      }\n\n      /* ── Footer panel — same layout and type as the main site ── */\n      .footer {\n        position: relative;\n        left: 0;\n        width: 100%;\n        min-height: var(--footer-height);\n        margin-top: -2px;\n        background: var(--color-blue);\n        display: grid;\n        grid-template-columns:\n          minmax(10rem, 1fr)\n          minmax(20rem, 33.125rem)\n          minmax(10rem, 1fr);\n        grid-template-rows: 1fr auto auto;\n        column-gap: clamp(2rem, 6vw, 6.5rem);\n        row-gap: 2.375rem;\n        align-items: start;\n        padding: 4.25rem var(--footer-pad-x) 3rem;\n        z-index: 100;\n      }\n\n      .footer-panel {\n        display: contents;\n      }\n\n      .footer-links {\n        display: flex;\n        flex-direction: column;\n        gap: 0.8125rem;\n        font-family: var(--font-ui);\n        font-size: var(--type-field);\n        line-height: 1;\n        font-weight: 400;\n        font-variation-settings:\n          \"ELGR\" 1,\n          \"ELSH\" 2,\n          \"wght\" 400;\n      }\n\n      .footer-links--support {\n        justify-self: end;\n        min-width: 10rem;\n      }\n\n      .footer-links a {\n        color: var(--color-bg);\n        text-decoration: none;\n      }\n\n      .footer-links a:hover {\n        text-decoration: underline;\n      }\n\n      .footer-heading {\n        margin: 0 0 0.25rem;\n        font-family: var(--font-body);\n        font-size: 0.75rem;\n        line-height: 1;\n        font-weight: 700;\n        color: var(--color-bg);\n        text-transform: uppercase;\n      }\n\n      .footer-newsletter {\n        display: flex;\n        flex-direction: column;\n        align-items: stretch;\n        justify-self: center;\n        width: 100%;\n      }\n\n      .footer-newsletter .footer-heading {\n        align-self: center;\n        margin-bottom: 1rem;\n        font-family: var(--font-display);\n        font-size: 1.375rem;\n        line-height: 1;\n        font-weight: 400;\n        text-align: center;\n      }\n\n      .field {\n        font-family: var(--font-ui);\n        font-size: var(--type-field);\n        font-weight: 400;\n        font-variation-settings:\n          \"ELGR\" 1,\n          \"ELSH\" 2,\n          \"wght\" 400;\n        height: var(--input-height);\n        border-radius: var(--radius-button);\n        border: 2px solid var(--color-ink);\n        background: var(--color-bg);\n        color: var(--color-ink);\n        padding: 0 1.375rem;\n        width: 100%;\n      }\n\n      .footer-newsletter-input.has-error {\n        color: var(--color-red);\n      }\n\n      .footer-newsletter-error {\n        min-height: 1rem;\n        margin-top: 0.5rem;\n        font-family: var(--font-body);\n        font-size: var(--type-error);\n        line-height: var(--leading-error);\n        color: var(--color-bg);\n        display: none;\n      }\n\n      .footer-newsletter.is-error .footer-newsletter-error {\n        display: block;\n      }\n\n      .ml-submit {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        width: 100%;\n        margin-top: 0.5rem;\n        height: var(--button-height);\n        border-radius: var(--radius-button);\n        background: var(--color-green);\n        color: var(--color-bg);\n        font-family: var(--font-ui);\n        font-size: var(--type-button);\n        font-weight: 700;\n        font-variation-settings:\n          \"ELGR\" 1,\n          \"ELSH\" 2,\n          \"wght\" 700;\n        border: 2px solid transparent;\n        cursor: pointer;\n        transition:\n          background 0.18s ease,\n          color 0.18s ease,\n          border-color 0.18s ease;\n      }\n\n      .ml-submit:hover {\n        background: transparent;\n        color: var(--color-green);\n        border-color: var(--color-green);\n      }\n\n      /* Success state — same copy as the site footer */\n      .footer-newsletter-success {\n        display: none;\n        text-align: center;\n        color: var(--color-bg);\n      }\n\n      .footer-newsletter.is-success .footer-newsletter-success {\n        display: block;\n      }\n\n      .footer-newsletter.is-success .footer-heading,\n      .footer-newsletter.is-success .footer-newsletter-input,\n      .footer-newsletter.is-success .footer-newsletter-submit,\n      .footer-newsletter.is-success .footer-newsletter-error {\n        display: none;\n      }\n\n      .footer-newsletter-success-heading {\n        font-family: var(--font-display);\n        font-size: 1.375rem;\n        line-height: 1;\n        font-weight: 400;\n        margin-bottom: 1rem;\n      }\n\n      .footer-newsletter-success-body {\n        font-family: var(--font-body);\n        font-size: var(--type-error);\n        line-height: var(--leading-error);\n      }\n\n      .footer-newsletter-success-body + .footer-newsletter-success-body {\n        margin-top: 1rem;\n      }\n\n      .footer-newsletter-reset {\n        appearance: none;\n        border: 0;\n        padding: 0;\n        background: none;\n        font: inherit;\n        font-weight: 700;\n        color: inherit;\n        text-decoration: underline;\n        cursor: pointer;\n      }\n\n      .footer-icons {\n        grid-column: 2;\n        grid-row: 2;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 1.25rem;\n        flex-shrink: 0;\n      }\n\n      .footer-icons a {\n        display: flex;\n        align-items: center;\n        width: 1.25rem;\n        height: 1.25rem;\n      }\n\n      .footer-icons img {\n        width: 100%;\n        height: 100%;\n        display: block;\n      }\n\n      .footer-copyright {\n        grid-column: 1 / -1;\n        grid-row: 3;\n        justify-self: center;\n        flex-shrink: 0;\n        font-family: var(--font-ui);\n        font-size: var(--type-field);\n        font-weight: 400;\n        color: var(--color-bg);\n        font-variation-settings:\n          \"ELGR\" 1,\n          \"ELSH\" 2,\n          \"wght\" 400;\n        white-space: nowrap;\n      }\n\n      @media (max-width: 768px) {\n        :root {\n          --footer-height: var(--footer-height-mobile);\n          --footer-pad-x: var(--content-left-mobile);\n          --footer-stack-height: calc(\n            var(--footer-height) + env(safe-area-inset-bottom, 0px)\n          );\n        }\n\n        #monster-group .monster-area {\n          height: var(--wave-height-mobile) !important;\n        }\n\n        #monster-group.has-mobile-monster-eyes #monster-eyes-svg {\n          display: none;\n        }\n\n        #monster-group.has-mobile-monster-eyes .monster-eyes-overlay-mobile {\n          display: block;\n        }\n\n        #monster-group.has-mobile-monster-eyes\n          .monster-area\n          .eye-blink-group.closing {\n          transform: none;\n          opacity: 0;\n          transition: opacity 50ms linear;\n        }\n\n        #monster-group.has-mobile-monster-eyes\n          .monster-area\n          .eye-blink-group.opening {\n          transform: none;\n          opacity: 1;\n          transition: opacity 80ms linear;\n        }\n\n        .footer {\n          grid-template-columns: 1fr;\n          grid-template-rows: auto auto auto;\n          gap: 1.75rem;\n          justify-content: unset;\n          align-items: stretch;\n          height: auto;\n          min-height: var(--footer-stack-height);\n          padding-top: 1.875rem;\n          padding-bottom: 1.5rem;\n          box-sizing: border-box;\n        }\n\n        .footer-panel {\n          display: grid;\n          grid-template-columns: 1fr;\n          gap: 1rem;\n        }\n\n        .footer-links,\n        .footer-links--support,\n        .footer-newsletter {\n          justify-self: stretch;\n          width: 100%;\n        }\n\n        .footer-links {\n          order: 1;\n          gap: 0.75rem;\n          font-size: 0.875rem;\n        }\n\n        .footer-links--support {\n          order: 2;\n        }\n\n        .footer-newsletter {\n          order: 3;\n          margin-top: 1.375rem;\n        }\n\n        .footer-heading {\n          margin-bottom: 0;\n          font-size: 0.75rem;\n        }\n\n        .footer-newsletter .footer-heading {\n          margin-bottom: 1rem;\n          font-size: 0.875rem;\n        }\n\n        .footer-icons {\n          grid-column: 1;\n          grid-row: 2;\n          align-self: center;\n          justify-self: center;\n        }\n\n        .footer-copyright {\n          grid-column: 1;\n          grid-row: 3;\n          align-self: center;\n          justify-self: center;\n          font-size: 0.875rem;\n        }\n      }\n\n      #shopify-section-sections--22918826721500__custom_liquid_g8ceP6 .section {\n        grid-template-columns: 0 100% 0;\n      }\n\n  /* Footer type — match staging (Global Font Edit: Field + B1) */\n  .footer .footer-links {\n    font-size: clamp(1rem, 1.3vw, 1.125rem);\n  }\n  .footer .footer-links .footer-heading {\n    font-size: clamp(1rem, 1.54vw, 1.125rem);\n  }\n  .footer .footer-copyright {\n    font-size: clamp(1rem, 1.3vw, 1.125rem);\n    line-height: 1;\n  }\n    </style>\n  </head>\n  <body>\n    <div class=\"page\">\n      <!-- page content yahan aayega -->\n\n      <div id=\"monster-group\" class=\"has-mobile-monster-eyes\">\n        <div class=\"monster-area\" id=\"monster-area\">\n          <img class=\"wave\" src=\"https://cdn.shopify.com/s/files/1/0841/4494/7420/files/monster-wave.svg?v=1783513986\" alt=\"\" />\n\n          <svg\n            class=\"monster-eyes-overlay\"\n            id=\"monster-eyes-svg\"\n            viewBox=\"0 0 1440 116.154\"\n            preserveAspectRatio=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <defs>\n              <clipPath id=\"mon-eye-r-clip\">\n                <path\n                  transform=\"translate(593.13 32.7)\"\n                  d=\"M0 26.2514C43.7331 -10.9423 82.9881 -6.48788 119.75 26.2514C75.9056 35.4212 35.555 36.426 0 26.2514Z\"\n                />\n              </clipPath>\n              <clipPath id=\"mon-eye-l-clip\">\n                <path\n                  transform=\"translate(431.49 31.57)\"\n                  d=\"M0 28.0226C45.7339 -12.7789 87.7997 -5.73732 127.849 28.0226C81.0428 37.8174 37.9608 38.8855 0 28.0226Z\"\n                />\n              </clipPath>\n            </defs>\n\n            <g class=\"eye-blink-group\">\n              <path\n                fill=\"#F7F2EC\"\n                transform=\"translate(593.13 32.7)\"\n                d=\"M0 26.2514C43.7331 -10.9423 82.9881 -6.48788 119.75 26.2514C75.9056 35.4212 35.555 36.426 0 26.2514Z\"\n              />\n              <circle\n                id=\"mon-iris-r\"\n                clip-path=\"url(#mon-eye-r-clip)\"\n                cx=\"652.9\"\n                cy=\"49.45\"\n                r=\"30\"\n                fill=\"#32261F\"\n              />\n            </g>\n\n            <g class=\"eye-blink-group\">\n              <path\n                fill=\"#F7F2EC\"\n                transform=\"translate(431.49 31.57)\"\n                d=\"M0 28.0226C45.7339 -12.7789 87.7997 -5.73732 127.849 28.0226C81.0428 37.8174 37.9608 38.8855 0 28.0226Z\"\n              />\n              <circle\n                id=\"mon-iris-l\"\n                clip-path=\"url(#mon-eye-l-clip)\"\n                cx=\"495.41\"\n                cy=\"49.46\"\n                r=\"30\"\n                fill=\"#32261F\"\n              />\n            </g>\n          </svg>\n\n          <svg\n            class=\"monster-eyes-overlay-mobile\"\n            id=\"monster-eyes-svg-mobile\"\n            viewBox=\"0 0 440 64\"\n            preserveAspectRatio=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <defs>\n              <clipPath id=\"mon-eye-r-clip-m\">\n                <path\n                  transform=\"translate(197.14 30.76)\"\n                  d=\"M0 17.6111C29.5302 -7.34075 56.0366 -4.35248 80.8595 17.6111C51.2543 23.7628 24.008 24.4369 0 17.6111Z\"\n                />\n              </clipPath>\n              <clipPath id=\"mon-eye-l-clip-m\">\n                <path\n                  transform=\"translate(88 30)\"\n                  d=\"M0 18.7993C30.8812 -8.57287 59.2856 -3.84896 86.3281 18.7993C54.7231 25.3703 25.6325 26.0869 0 18.7993Z\"\n                />\n              </clipPath>\n            </defs>\n\n            <g class=\"eye-blink-group\">\n              <path\n                fill=\"#F7F2EC\"\n                transform=\"translate(197.14 30.76)\"\n                d=\"M0 17.6111C29.5302 -7.34075 56.0366 -4.35248 80.8595 17.6111C51.2543 23.7628 24.008 24.4369 0 17.6111Z\"\n              />\n              <circle\n                id=\"mon-iris-r-m\"\n                clip-path=\"url(#mon-eye-r-clip-m)\"\n                cx=\"248.5\"\n                cy=\"62.5\"\n                r=\"27.5\"\n                fill=\"#32261F\"\n              />\n            </g>\n\n            <g class=\"eye-blink-group\">\n              <path\n                fill=\"#F7F2EC\"\n                transform=\"translate(88 30)\"\n                d=\"M0 18.7993C30.8812 -8.57287 59.2856 -3.84896 86.3281 18.7993C54.7231 25.3703 25.6325 26.0869 0 18.7993Z\"\n              />\n              <circle\n                id=\"mon-iris-l-m\"\n                clip-path=\"url(#mon-eye-l-clip-m)\"\n                cx=\"142\"\n                cy=\"64\"\n                r=\"29\"\n                fill=\"#32261F\"\n              />\n            </g>\n          </svg>\n        </div>\n      </div>\n\n      <footer class=\"footer\">\n        <div class=\"footer-panel\">\n          <nav class=\"footer-links\" aria-label=\"Information\">\n            <h2 class=\"footer-heading\">Information</h2>\n            <a href=\"https://www.knocktwice.studio/terms/\">Terms of Service</a>\n            <a href=\"https://www.knocktwice.studio/privacy/\">Privacy Policy</a>\n            <a href=\"https://www.knocktwice.studio/accessibility/\">Accessibility Statement</a>\n          </nav>\n\n          <form class=\"footer-newsletter\" data-footer-newsletter novalidate>\n            <h2 class=\"footer-heading\">JOIN OUR MAILING LIST 📒</h2>\n            <input\n              class=\"field footer-newsletter-input\"\n              type=\"email\"\n              placeholder=\"yourname@gmail.com\"\n              autocomplete=\"email\"\n              aria-label=\"Email address\"\n            />\n            <p class=\"footer-newsletter-error\">\n              Hmm. That email doesn't look right. Try again?\n            </p>\n            <button class=\"ml-submit footer-newsletter-submit\" type=\"submit\">\n              Sign Up\n            </button>\n          </form>\n\n          <nav class=\"footer-links footer-links--support\" aria-label=\"Support\">\n            <h2 class=\"footer-heading\">Support</h2>\n            <a href=\"https://www.knocktwice.studio/faqs/\">Contact Us &amp; FAQs</a>\n            <a href=\"https://www.knocktwice.studio/returns/\">Shipping &amp; Returns</a>\n          </nav>\n        </div>\n\n        <div class=\"footer-icons\">\n          <a\n            href=\"https://www.instagram.com/knocktwice.studio\"\n            aria-label=\"Instagram\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n          >\n            <img src=\"https://cdn.shopify.com/s/files/1/0841/4494/7420/files/icon-instagram.svg?v=1783513986\" alt=\"Instagram\" />\n          </a>\n\n          <a\n            href=\"https://www.tiktok.com/@knocktwice.studio\"\n            aria-label=\"TikTok\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n          >\n            <img src=\"https://cdn.shopify.com/s/files/1/0841/4494/7420/files/icon-tiktok.svg?v=1783513986\" alt=\"TikTok\" />\n          </a>\n        </div>\n\n        <span class=\"footer-copyright\">\n          © 2026 Knock Twice Studio. All rights reserved.\n        </span>\n      </footer>\n    </div>\n\n    <script>\n      const page = document.querySelector(\".page\");\n      const monsterGroup = document.getElementById(\"monster-group\");\n      const monsterArea = document.getElementById(\"monster-area\");\n      const monIrisR = document.getElementById(\"mon-iris-r\");\n      const monIrisL = document.getElementById(\"mon-iris-l\");\n      const monIrisRM = document.getElementById(\"mon-iris-r-m\");\n      const monIrisLM = document.getElementById(\"mon-iris-l-m\");\n\n      function isMonsterMobileLayout() {\n        return window.innerWidth <= 768;\n      }\n\n      function trackIris(el, localX, localY, restX, restY, maxX, maxY) {\n        const dx = localX - restX;\n        const dy = localY - restY;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n\n        if (dist < 1) {\n          el.setAttribute(\"cx\", restX);\n          el.setAttribute(\"cy\", restY);\n          return;\n        }\n\n        const nx = dx / dist;\n        const ny = dy / dist;\n        const strength = Math.min(dist / 200, 1);\n        const kx = 0.55;\n        const ky = 0.28;\n\n        el.setAttribute(\"cx\", restX + nx * maxX * kx * strength);\n        el.setAttribute(\"cy\", restY + ny * maxY * ky * strength);\n      }\n\n      function moveMobileMonsterEyes(vx, vy) {\n        if (!monIrisRM || !monIrisLM) return;\n\n        const wr = monsterArea.getBoundingClientRect();\n        const svgX = ((vx - wr.left) / wr.width) * 440;\n        const svgY = ((vy - wr.top) / wr.height) * 64;\n\n        trackIris(monIrisRM, svgX, svgY, 248.5, 62.5, 10, 3);\n        trackIris(monIrisLM, svgX, svgY, 142, 64, 10, 3);\n      }\n\n      const monsterBlinkGroups = document.querySelectorAll(\n        \"#monster-area .eye-blink-group\",\n      );\n\n      function footerMonsterBlink() {\n        monsterBlinkGroups.forEach(function (g) {\n          g.classList.add(\"closing\");\n        });\n\n        setTimeout(function () {\n          monsterBlinkGroups.forEach(function (g) {\n            g.classList.remove(\"closing\");\n            g.classList.add(\"opening\");\n          });\n\n          setTimeout(function () {\n            monsterBlinkGroups.forEach(function (g) {\n              g.classList.remove(\"opening\");\n            });\n          }, 110);\n        }, 65);\n      }\n\n      function scheduleFooterMonsterBlink() {\n        setTimeout(\n          function () {\n            footerMonsterBlink();\n            scheduleFooterMonsterBlink();\n          },\n          2000 + Math.random() * 5000,\n        );\n      }\n\n      scheduleFooterMonsterBlink();\n\n      requestAnimationFrame(function () {\n        requestAnimationFrame(function () {\n          monsterGroup.classList.add(\"popped-up\");\n        });\n      });\n\n      function getWaveTop() {\n        const pageRect = page.getBoundingClientRect();\n        const waveRect = monsterArea.getBoundingClientRect();\n        return waveRect.top - pageRect.top;\n      }\n\n      let eyeRaf = 0;\n      let eyeMX = 0;\n      let eyeMY = 0;\n\n      function updateMonsterEyesFrame() {\n        eyeRaf = 0;\n\n        if (isMonsterMobileLayout()) {\n          moveMobileMonsterEyes(eyeMX, eyeMY);\n          return;\n        }\n\n        const waveTop = getWaveTop();\n        const pageRect = page.getBoundingClientRect();\n        const x =\n          ((eyeMX - pageRect.left) /\n            monsterArea.getBoundingClientRect().width) *\n          1440;\n        const y = eyeMY - pageRect.top;\n\n        trackIris(monIrisR, x, y - waveTop, 652.9, 49.45, 20, 5);\n        trackIris(monIrisL, x, y - waveTop, 495.41, 49.46, 20, 5);\n      }\n\n      document.addEventListener(\n        \"mousemove\",\n        function (e) {\n          eyeMX = e.clientX;\n          eyeMY = e.clientY;\n          if (!eyeRaf) eyeRaf = requestAnimationFrame(updateMonsterEyesFrame);\n        },\n        { passive: true },\n      );\n\n      document.addEventListener(\n        \"touchmove\",\n        function (e) {\n          if (!e.touches.length) return;\n          eyeMX = e.touches[0].clientX;\n          eyeMY = e.touches[0].clientY;\n          if (!eyeRaf) eyeRaf = requestAnimationFrame(updateMonsterEyesFrame);\n        },\n        { passive: true },\n      );\n\n      // ── Mailing list — same behaviour and copy as the site footer ──\n      (function () {\n        function ktFooterNewsletter() {\n          var form = document.querySelector(\"[data-footer-newsletter]\");\n          if (!form) return;\n\n          var input = form.querySelector(\".footer-newsletter-input\");\n          var sheetUrl =\n            \"https://script.google.com/macros/s/AKfycbyIKQkkXpe8kO5tsrhDdunKesfhD-xJGHTBSN1FhOC_Z-veuRK8fxkEbzX4_cbhmtZm/exec\";\n          var emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n          var panel = document.createElement(\"div\");\n          panel.className = \"footer-newsletter-success\";\n\n          var heading = document.createElement(\"p\");\n          heading.className = \"footer-newsletter-success-heading\";\n          heading.textContent = \"YAY, YOU'RE OFFICIALLY A KNOCKER! 💖\";\n\n          var body = document.createElement(\"p\");\n          body.className = \"footer-newsletter-success-body\";\n          body.textContent =\n            \"We'll be knocking at your door (email) sometime soon! As promised, we'll never get offended if you decide to unsubscribe.\";\n\n          var again = document.createElement(\"p\");\n          again.className = \"footer-newsletter-success-body\";\n          again.appendChild(\n            document.createTextNode(\n              \"Used the wrong email or want to sign up with a different email, click \",\n            ),\n          );\n\n          var reset = document.createElement(\"button\");\n          reset.type = \"button\";\n          reset.className = \"footer-newsletter-reset\";\n          reset.textContent = \"here\";\n          again.appendChild(reset);\n          again.appendChild(document.createTextNode(\".\"));\n\n          panel.appendChild(heading);\n          panel.appendChild(body);\n          panel.appendChild(again);\n          form.appendChild(panel);\n\n          reset.addEventListener(\"click\", function () {\n            form.classList.remove(\"is-success\");\n            input.value = \"\";\n            input.focus();\n          });\n\n          input.addEventListener(\"input\", function () {\n            form.classList.remove(\"is-error\");\n            input.classList.remove(\"has-error\");\n          });\n\n          form.addEventListener(\"submit\", function (event) {\n            event.preventDefault();\n            var email = input.value.trim();\n\n            if (!emailRe.test(email)) {\n              form.classList.add(\"is-error\");\n              form.classList.remove(\"is-success\");\n              input.classList.add(\"has-error\");\n              return;\n            }\n\n            form.classList.remove(\"is-error\");\n            input.classList.remove(\"has-error\");\n            form.classList.add(\"is-success\");\n            fetch(sheetUrl + \"?email=\" + encodeURIComponent(email), {\n              mode: \"no-cors\",\n            }).catch(function () {});\n          });\n        }\n\n        if (document.readyState === \"loading\") {\n          document.addEventListener(\"DOMContentLoaded\", ktFooterNewsletter);\n        } else {\n          ktFooterNewsletter();\n        }\n      })();\n    </script>\n  </body>\n</html>",
