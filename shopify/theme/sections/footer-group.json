    "custom_liquid_Hibfgp": {
      "type": "custom-liquid",
      "name": "correct footer",
      "settings": {
        "custom_liquid": "<!--\n  Knock Twice — footer for the Shopify store (product pages, cart, etc.)\n\n  HOW TO USE\n  Shopify admin → Online Store → Themes → Customize → Footer → \"Custom Liquid\"\n  block → delete everything in it → paste this whole file → Save.\n\n  SOURCE OF TRUTH\n  This is a copy of the native footer on /shop/ (shop/index.html +\n  assets/styles.css + assets/scripts.js). When the native footer changes,\n  update this file and paste it into Shopify again.\n\n  Everything is scoped under #kt-footer so the Horizon theme's own styles\n  (white inputs, section grid, etc.) can't leak in and ours can't leak out.\n-->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Handjet:wght@100..900&display=swap\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Erica+One&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* Horizon wraps this block in a page-width grid section. Take it out of\n     that grid so the wave and panel run edge to edge (this was the\n     straight line on each side of the footer). */\n  .shopify-section:has(#kt-footer),\n  .shopify-section:has(#kt-footer) > .section {\n    display: block !important;\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n  .shopify-section:has(#kt-footer) .section-background {\n    display: none !important;\n  }\n\n  /* Horizon scrolls the page inside .page-wrapper and shows its own\n     scrollbar, which reads as a strip down the right edge of the blue\n     footer. The native site hides the scrollbar (shop/index.html), so do\n     the same here. The page still scrolls normally. */\n  html,\n  body,\n  .page-wrapper {\n    scrollbar-width: none !important;\n  }\n  html::-webkit-scrollbar,\n  body::-webkit-scrollbar,\n  .page-wrapper::-webkit-scrollbar {\n    display: none !important;\n  }\n\n  #kt-footer {\n    /* Design system values (assets/styles.css) */\n    --color-bg: #F7F2EC;\n    --color-ink: #32261F;\n    --color-blue: #378CDA;\n    --color-green: #51B18C;\n    --color-khaki: #D1C3B6;\n    --color-white: #FFFFFF;\n    --color-red: #FF0004;\n    --font-display: 'Erica One', serif;\n    --font-body: 'Instrument Sans', sans-serif;\n    --font-ui: 'Handjet', sans-serif;\n    --type-b1: clamp(1rem, 1.54vw, 1.125rem);\n    --type-field: clamp(1rem, 1.3vw, 1.125rem);\n    --type-button: clamp(1rem, 1.3vw, 1.125rem);\n    --type-error: clamp(0.75rem, 1vw, 0.875rem);\n    --leading-error: clamp(1.0625rem, 1.39vw, 1.25rem);\n    --radius-button: 6.25rem;\n    --input-height: 3.4375rem;\n    --button-height: 3.4375rem;\n    --footer-panel-height: 22.5rem;\n    --footer-pad-x: 2.5rem;\n    --content-left-mobile: 1.25rem;\n    --wave-height-desktop: 6.875rem;\n    --wave-height-mobile: 4rem;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    background: var(--color-bg);\n    font-family: var(--font-body);\n    font-size: 16px;\n    line-height: normal;\n    -webkit-font-smoothing: antialiased;\n  }\n  #kt-footer *,\n  #kt-footer *::before,\n  #kt-footer *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* ── Wave + eyes ── */\n  #kt-footer #monster-group {\n    position: relative;\n    width: 100%;\n    z-index: 5;\n    transform: translateY(250px);\n    will-change: transform;\n  }\n  #kt-footer #monster-group.popped-up {\n    transform: translateY(0);\n    transition: transform 1800ms cubic-bezier(0.16, 1, 0.3, 1);\n    transition-delay: 1.1s;\n  }\n  #kt-footer .monster-area {\n    position: relative;\n    width: 100%;\n    height: var(--wave-height-desktop);\n  }\n  #kt-footer .wave,\n  #kt-footer .monster-eyes-overlay,\n  #kt-footer .monster-eyes-overlay-mobile {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    display: block;\n    pointer-events: none;\n    overflow: visible;\n  }\n  #kt-footer .monster-eyes-overlay-mobile {\n    display: none;\n  }\n  #kt-footer .eye-blink-group {\n    transform-box: fill-box;\n    transform-origin: center;\n  }\n  #kt-footer .eye-blink-group.closing {\n    transform: scaleY(0);\n    transition: transform 60ms ease-in;\n  }\n  #kt-footer .eye-blink-group.opening {\n    transform: scaleY(1);\n    transition: transform 100ms ease-out;\n  }\n\n  /* ── Footer panel ── */\n  #kt-footer .footer {\n    position: relative;\n    width: 100%;\n    height: var(--footer-panel-height);\n    margin-top: -0px;\n    background: var(--color-blue);\n    display: grid;\n    grid-template-columns: minmax(10rem, 1fr) minmax(20rem, 33.125rem) minmax(10rem, 1fr);\n    grid-template-rows: 1fr auto auto;\n    column-gap: clamp(2rem, 6vw, 6.5rem);\n    row-gap: 2.375rem;\n    align-items: start;\n    padding: 4.25rem var(--footer-pad-x) 3rem;\n    z-index: 100;\n  }\n  #kt-footer .footer-panel {\n    display: contents;\n  }\n  #kt-footer .footer-links {\n    display: flex;\n    flex-direction: column;\n    gap: 0.8125rem;\n    font-family: var(--font-ui);\n    font-size: var(--type-field);\n    line-height: 1;\n    font-weight: 400;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 400;\n  }\n  #kt-footer .footer-links--support {\n    justify-self: end;\n    min-width: 10rem;\n  }\n  #kt-footer .footer-heading {\n    margin: 0 0 0.25rem;\n    font-family: var(--font-body);\n    font-size: var(--type-b1);\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: normal;\n    color: var(--color-bg);\n    text-transform: uppercase;\n  }\n  #kt-footer .footer-links a {\n    color: var(--color-bg);\n    text-decoration: none;\n  }\n  #kt-footer .footer-links a:hover {\n    text-decoration: underline;\n  }\n\n  /* ── Mailing list ── */\n  #kt-footer .footer-newsletter {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    justify-self: center;\n    width: 100%;\n  }\n  #kt-footer .footer-newsletter .footer-heading {\n    align-self: center;\n    margin-bottom: 1rem;\n    font-family: var(--font-display);\n    font-size: 1.375rem;\n    line-height: 1;\n    font-weight: 400;\n    text-align: center;\n    text-transform: none;\n  }\n  #kt-footer .field {\n    appearance: none;\n    font-family: var(--font-ui);\n    font-size: var(--type-field);\n    font-weight: 400;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 400;\n    line-height: normal;\n    height: var(--input-height);\n    border-radius: var(--radius-button);\n    border: 2px solid var(--color-ink);\n    background: var(--color-bg);\n    color: var(--color-ink);\n    box-shadow: none;\n    padding: 0 1.375rem;\n    width: 100%;\n  }\n  #kt-footer .field::placeholder {\n    color: var(--color-khaki);\n    opacity: 1;\n  }\n  #kt-footer .field:focus {\n    outline: none;\n    border-color: var(--color-green);\n  }\n  #kt-footer .footer-newsletter-input.has-error {\n    color: var(--color-red);\n  }\n  #kt-footer .footer-newsletter-error {\n    display: none;\n    min-height: 1rem;\n    margin-top: 0.5rem;\n    font-family: var(--font-body);\n    font-size: var(--type-error);\n    line-height: var(--leading-error);\n    color: var(--color-bg);\n  }\n  #kt-footer .footer-newsletter.is-error .footer-newsletter-error {\n    display: block;\n  }\n  #kt-footer .ml-submit {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    margin-top: 0.5rem;\n    padding: 0 4.5rem;\n    height: var(--button-height);\n    border-radius: var(--radius-button);\n    background: var(--color-green);\n    color: var(--color-bg);\n    font-family: var(--font-ui);\n    font-size: var(--type-button);\n    font-weight: 700;\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 700;\n    letter-spacing: normal;\n    text-transform: none;\n    border: 2px solid transparent;\n    box-shadow: none;\n    cursor: pointer;\n    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;\n  }\n  /* Green outline would vanish on the blue footer, so hover goes white. */\n  #kt-footer .ml-submit:hover {\n    background: transparent;\n    color: var(--color-white);\n    border-color: var(--color-white);\n  }\n\n  /* Success state — replaces heading, field and button in place */\n  #kt-footer .footer-newsletter-success {\n    display: none;\n    text-align: center;\n    color: var(--color-bg);\n  }\n  #kt-footer .footer-newsletter.is-success .footer-newsletter-success {\n    display: block;\n  }\n  #kt-footer .footer-newsletter.is-success .footer-heading,\n  #kt-footer .footer-newsletter.is-success .footer-newsletter-input,\n  #kt-footer .footer-newsletter.is-success .footer-newsletter-submit,\n  #kt-footer .footer-newsletter.is-success .footer-newsletter-error {\n    display: none;\n  }\n  #kt-footer .footer-newsletter-success-heading {\n    font-family: var(--font-display);\n    font-size: 1.375rem;\n    line-height: 1;\n    font-weight: 400;\n    margin-bottom: 1rem;\n  }\n  #kt-footer .footer-newsletter-success-body {\n    font-family: var(--font-body);\n    font-size: var(--type-error);\n    line-height: var(--leading-error);\n    font-weight: 400;\n  }\n  #kt-footer .footer-newsletter-success-body + .footer-newsletter-success-body {\n    margin-top: 1rem;\n  }\n  #kt-footer .footer-newsletter-reset {\n    appearance: none;\n    border: 0;\n    padding: 0;\n    background: none;\n    font: inherit;\n    font-weight: 700;\n    color: inherit;\n    text-decoration: underline;\n    cursor: pointer;\n  }\n  #kt-footer .footer-newsletter-reset:hover {\n    text-decoration: none;\n  }\n\n  /* ── Icons + copyright ── */\n  #kt-footer .footer-icons {\n    grid-column: 2;\n    grid-row: 2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 1.25rem;\n  }\n  #kt-footer .footer-icons a {\n    display: flex;\n    align-items: center;\n    width: 1.25rem;\n    height: 1.25rem;\n  }\n  #kt-footer .footer-icons img {\n    width: 100%;\n    height: 100%;\n    display: block;\n  }\n  #kt-footer .footer-copyright {\n    grid-column: 2;\n    grid-row: 3;\n    justify-self: center;\n    font-family: var(--font-ui);\n    font-size: var(--type-field);\n    line-height: 1;\n    font-weight: 400;\n    color: var(--color-bg);\n    font-variation-settings: 'ELGR' 1, 'ELSH' 2, 'wght' 400;\n    white-space: nowrap;\n  }\n\n  /* ── Mobile (768px and below) ── */\n  @media (max-width: 768px) {\n    #kt-footer {\n      --footer-panel-height: 26.875rem;\n      --footer-pad-x: var(--content-left-mobile);\n    }\n    #kt-footer .monster-area {\n      height: var(--wave-height-mobile);\n    }\n    #kt-footer .monster-eyes-overlay {\n      display: none;\n    }\n    #kt-footer .monster-eyes-overlay-mobile {\n      display: block;\n    }\n    #kt-footer .eye-blink-group.closing {\n      transform: none;\n      opacity: 0;\n      transition: opacity 50ms linear;\n    }\n    #kt-footer .eye-blink-group.opening {\n      transform: none;\n      opacity: 1;\n      transition: opacity 80ms linear;\n    }\n    #kt-footer .footer {\n      grid-template-columns: 1fr;\n      grid-template-rows: auto auto auto;\n      gap: 1.75rem;\n      align-items: stretch;\n      height: auto;\n      min-height: calc(var(--footer-panel-height) + env(safe-area-inset-bottom, 0px));\n      padding-top: 1.875rem;\n      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));\n    }\n    #kt-footer .footer-panel {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 1rem;\n    }\n    #kt-footer .footer-links,\n    #kt-footer .footer-links--support,\n    #kt-footer .footer-newsletter {\n      justify-self: stretch;\n      width: 100%;\n    }\n    #kt-footer .footer-links {\n      order: 1;\n      gap: 0.75rem;\n    }\n    #kt-footer .footer-links--support {\n      order: 2;\n    }\n    #kt-footer .footer-heading {\n      margin-bottom: 0;\n    }\n    #kt-footer .footer-newsletter {\n      order: 3;\n      margin-top: 1.375rem;\n    }\n    #kt-footer .footer-newsletter .footer-heading {\n      margin-bottom: 1rem;\n      font-size: 0.875rem;\n    }\n    #kt-footer .footer-icons {\n      grid-column: 1;\n      grid-row: 2;\n      align-self: center;\n      justify-self: center;\n    }\n    #kt-footer .footer-copyright {\n      grid-column: 1;\n      grid-row: 3;\n      align-self: center;\n      justify-self: center;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #kt-footer #monster-group {\n      transform: none;\n      transition: none;\n    }\n  }\n</style>\n\n<div id=\"kt-footer\">\n  <div id=\"monster-group\">\n    <div class=\"monster-area\" id=\"monster-area\">\n      <!-- Same wave as /shop/ (assets/monster-wave-shop.svg), inlined -->\n      <svg class=\"wave\" viewBox=\"0 0 1440 110\" preserveAspectRatio=\"none\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M0 110C0 110 199.8 0 574.834 0C750.95 0 1440 110 1440 110\" fill=\"#378CDA\" transform=\"translate(0 2)\"/>\n        <path d=\"M0 110C0 110 199.8 0 574.834 0C750.95 0 1440 110 1440 110\" fill=\"#378CDA\"/>\n      </svg>\n\n      <svg class=\"monster-eyes-overlay\" id=\"monster-eyes-svg\" viewBox=\"0 0 1440 116.154\" preserveAspectRatio=\"none\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <clipPath id=\"mon-eye-r-clip\">\n            <path transform=\"translate(593.13 32.7)\" d=\"M0 26.2514C43.7331 -10.9423 82.9881 -6.48788 119.75 26.2514C75.9056 35.4212 35.555 36.426 0 26.2514Z\"/>\n          </clipPath>\n          <clipPath id=\"mon-eye-l-clip\">\n            <path transform=\"translate(431.49 31.57)\" d=\"M0 28.0226C45.7339 -12.7789 87.7997 -5.73732 127.849 28.0226C81.0428 37.8174 37.9608 38.8855 0 28.0226Z\"/>\n          </clipPath>\n        </defs>\n        <g class=\"eye-blink-group\">\n          <path fill=\"#F7F2EC\" transform=\"translate(593.13 32.7)\" d=\"M0 26.2514C43.7331 -10.9423 82.9881 -6.48788 119.75 26.2514C75.9056 35.4212 35.555 36.426 0 26.2514Z\"/>\n          <circle id=\"mon-iris-r\" clip-path=\"url(#mon-eye-r-clip)\" cx=\"652.9\" cy=\"49.45\" r=\"30\" fill=\"#32261F\"/>\n        </g>\n        <g class=\"eye-blink-group\">\n          <path fill=\"#F7F2EC\" transform=\"translate(431.49 31.57)\" d=\"M0 28.0226C45.7339 -12.7789 87.7997 -5.73732 127.849 28.0226C81.0428 37.8174 37.9608 38.8855 0 28.0226Z\"/>\n          <circle id=\"mon-iris-l\" clip-path=\"url(#mon-eye-l-clip)\" cx=\"495.41\" cy=\"49.46\" r=\"30\" fill=\"#32261F\"/>\n        </g>\n      </svg>\n\n      <svg class=\"monster-eyes-overlay-mobile\" id=\"monster-eyes-svg-mobile\" viewBox=\"0 0 440 64\" preserveAspectRatio=\"none\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <clipPath id=\"mon-eye-r-clip-m\">\n            <path transform=\"translate(197.14 30.76)\" d=\"M0 17.6111C29.5302 -7.34075 56.0366 -4.35248 80.8595 17.6111C51.2543 23.7628 24.008 24.4369 0 17.6111Z\"/>\n          </clipPath>\n          <clipPath id=\"mon-eye-l-clip-m\">\n            <path transform=\"translate(88 30)\" d=\"M0 18.7993C30.8812 -8.57287 59.2856 -3.84896 86.3281 18.7993C54.7231 25.3703 25.6325 26.0869 0 18.7993Z\"/>\n          </clipPath>\n        </defs>\n        <g class=\"eye-blink-group\">\n          <path fill=\"#F7F2EC\" transform=\"translate(197.14 30.76)\" d=\"M0 17.6111C29.5302 -7.34075 56.0366 -4.35248 80.8595 17.6111C51.2543 23.7628 24.008 24.4369 0 17.6111Z\"/>\n          <circle id=\"mon-iris-r-m\" clip-path=\"url(#mon-eye-r-clip-m)\" cx=\"248.5\" cy=\"62.5\" r=\"27.5\" fill=\"#32261F\"/>\n        </g>\n        <g class=\"eye-blink-group\">\n          <path fill=\"#F7F2EC\" transform=\"translate(88 30)\" d=\"M0 18.7993C30.8812 -8.57287 59.2856 -3.84896 86.3281 18.7993C54.7231 25.3703 25.6325 26.0869 0 18.7993Z\"/>\n          <circle id=\"mon-iris-l-m\" clip-path=\"url(#mon-eye-l-clip-m)\" cx=\"142\" cy=\"64\" r=\"29\" fill=\"#32261F\"/>\n        </g>\n      </svg>\n    </div>\n  </div>\n\n  <footer class=\"footer\">\n    <div class=\"footer-panel\">\n      <nav class=\"footer-links\" aria-label=\"Information\">\n        <h2 class=\"footer-heading\">Information</h2>\n        <a href=\"https://www.knocktwice.studio/terms/\">Terms of Service</a>\n        <a href=\"https://www.knocktwice.studio/privacy/\">Privacy Policy</a>\n        <a href=\"https://www.knocktwice.studio/accessibility/\">Accessibility Statement</a>\n      </nav>\n      <form class=\"footer-newsletter\" data-footer-newsletter novalidate>\n        <h2 class=\"footer-heading\">JOIN OUR MAILING LIST 📒</h2>\n        <input class=\"field footer-newsletter-input\" type=\"email\" placeholder=\"yourname@gmail.com\" autocomplete=\"email\" aria-label=\"Email address\">\n        <p class=\"footer-newsletter-error\">Hmm. That email doesn't look right. Try again?</p>\n        <button class=\"ml-submit footer-newsletter-submit\" type=\"submit\">Sign Up</button>\n      </form>\n      <nav class=\"footer-links footer-links--support\" aria-label=\"Support\">\n        <h2 class=\"footer-heading\">Support</h2>\n        <a href=\"https://www.knocktwice.studio/faqs/\">Contact Us &amp; FAQs</a>\n        <a href=\"https://www.knocktwice.studio/returns/\">Shipping &amp; Returns</a>\n      </nav>\n    </div>\n    <div class=\"footer-icons\">\n      <a href=\"https://www.instagram.com/knocktwice.studio\" aria-label=\"Instagram\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0841/4494/7420/files/icon-instagram.svg?v=1783513986\" alt=\"Instagram\">\n      </a>\n      <a href=\"https://www.tiktok.com/@knocktwice.studio\" aria-label=\"TikTok\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0841/4494/7420/files/icon-tiktok.svg?v=1783513986\" alt=\"TikTok\">\n      </a>\n    </div>\n    <span class=\"footer-copyright\">© 2026 Knock Twice Studio. All rights reserved.</span>\n  </footer>\n</div>\n\n<script>\n  (function () {\n    var root = document.getElementById('kt-footer');\n    if (!root) return;\n\n    var monsterGroup = root.querySelector('#monster-group');\n    var monsterArea = root.querySelector('#monster-area');\n    var irisR = root.querySelector('#mon-iris-r');\n    var irisL = root.querySelector('#mon-iris-l');\n    var irisRM = root.querySelector('#mon-iris-r-m');\n    var irisLM = root.querySelector('#mon-iris-l-m');\n    var blinkGroups = root.querySelectorAll('.eye-blink-group');\n\n    // ── Wave pops up on load ──\n    requestAnimationFrame(function () {\n      requestAnimationFrame(function () {\n        monsterGroup.classList.add('popped-up');\n      });\n    });\n\n    // ── Eyes follow the cursor / finger ──\n    function trackIris(el, x, y, restX, restY, maxX, maxY) {\n      var dx = x - restX;\n      var dy = y - restY;\n      var dist = Math.sqrt(dx * dx + dy * dy);\n      if (dist < 1) {\n        el.setAttribute('cx', restX);\n        el.setAttribute('cy', restY);\n        return;\n      }\n      var strength = Math.min(dist / 200, 1);\n      el.setAttribute('cx', restX + (dx / dist) * maxX * 0.55 * strength);\n      el.setAttribute('cy', restY + (dy / dist) * maxY * 0.28 * strength);\n    }\n\n    var raf = 0;\n    var mx = 0;\n    var my = 0;\n\n    function updateEyes() {\n      raf = 0;\n      var r = monsterArea.getBoundingClientRect();\n      if (window.innerWidth <= 768) {\n        var mxm = ((mx - r.left) / r.width) * 440;\n        var mym = ((my - r.top) / r.height) * 64;\n        trackIris(irisRM, mxm, mym, 248.5, 62.5, 10, 3);\n        trackIris(irisLM, mxm, mym, 142, 64, 10, 3);\n        return;\n      }\n      var x = ((mx - r.left) / r.width) * 1440;\n      var y = my - r.top;\n      trackIris(irisR, x, y, 652.9, 49.45, 20, 5);\n      trackIris(irisL, x, y, 495.41, 49.46, 20, 5);\n    }\n\n    function onPointer(x, y) {\n      mx = x;\n      my = y;\n      if (!raf) raf = requestAnimationFrame(updateEyes);\n    }\n\n    document.addEventListener('mousemove', function (e) {\n      onPointer(e.clientX, e.clientY);\n    }, { passive: true });\n    document.addEventListener('touchmove', function (e) {\n      if (e.touches.length) onPointer(e.touches[0].clientX, e.touches[0].clientY);\n    }, { passive: true });\n\n    // ── Blink every 2–7 seconds ──\n    function blink() {\n      blinkGroups.forEach(function (g) { g.classList.add('closing'); });\n      setTimeout(function () {\n        blinkGroups.forEach(function (g) {\n          g.classList.remove('closing');\n          g.classList.add('opening');\n        });\n        setTimeout(function () {\n          blinkGroups.forEach(function (g) { g.classList.remove('opening'); });\n        }, 110);\n      }, 65);\n    }\n    (function scheduleBlink() {\n      setTimeout(function () {\n        blink();\n        scheduleBlink();\n      }, 2000 + Math.random() * 5000);\n    })();\n\n    // ── Mailing list (same copy and endpoint as assets/scripts.js) ──\n    var form = root.querySelector('[data-footer-newsletter]');\n    var input = form.querySelector('.footer-newsletter-input');\n    var sheetUrl = 'https://script.google.com/macros/s/AKfycbyIKQkkXpe8kO5tsrhDdunKesfhD-xJGHTBSN1FhOC_Z-veuRK8fxkEbzX4_cbhmtZm/exec';\n    var emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n    var panel = document.createElement('div');\n    panel.className = 'footer-newsletter-success';\n    var heading = document.createElement('p');\n    heading.className = 'footer-newsletter-success-heading';\n    heading.textContent = \"YAY, YOU'RE OFFICIALLY A KNOCKER! 💖\";\n    var body = document.createElement('p');\n    body.className = 'footer-newsletter-success-body';\n    body.textContent = \"We'll be knocking at your door (email) sometime soon! As promised, we'll never get offended if you decide to unsubscribe.\";\n    var again = document.createElement('p');\n    again.className = 'footer-newsletter-success-body';\n    again.appendChild(document.createTextNode('Used the wrong email or want to sign up with a different email, click '));\n    var reset = document.createElement('button');\n    reset.type = 'button';\n    reset.className = 'footer-newsletter-reset';\n    reset.textContent = 'here';\n    again.appendChild(reset);\n    again.appendChild(document.createTextNode('.'));\n    panel.appendChild(heading);\n    panel.appendChild(body);\n    panel.appendChild(again);\n    form.appendChild(panel);\n\n    reset.addEventListener('click', function () {\n      form.classList.remove('is-success');\n      input.value = '';\n      input.focus();\n    });\n\n    input.addEventListener('input', function () {\n      form.classList.remove('is-error');\n      input.classList.remove('has-error');\n    });\n\n    form.addEventListener('submit', function (event) {\n      event.preventDefault();\n      var email = input.value.trim();\n      if (!emailRe.test(email)) {\n        form.classList.add('is-error');\n        form.classList.remove('is-success');\n        input.classList.add('has-error');\n        return;\n      }\n      form.classList.remove('is-error');\n      input.classList.remove('has-error');\n      form.classList.add('is-success');\n      fetch(sheetUrl + '?email=' + encodeURIComponent(email), { mode: 'no-cors' })\n        .catch(function () {});\n    });\n  })();\n</script>",
