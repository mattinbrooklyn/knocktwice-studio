{%- comment -%}
  Knock Twice — "Tell Me More" and "Shipping & Stuff" dropdowns.
  Each dropdown shows the product's own text when its product field is
  filled ("Tell Me More" custom.tell_me_more, "Shipping & Stuff"
  custom.shipping_and_stuff), otherwise the default text set on this
  block in the theme editor. Tick "Tell Me More" / "Shipping & Stuff" in
  the product's "Hide on this product" field to hide one.
  Same markup and styles as the theme's own Accordion block, so the
  FAQ-style dropdown look and single-open behaviour still apply.
{%- endcomment -%}
{%- liquid
  assign product_resource = closest.product | default: product
-%}
{%- capture hidden -%}{%- render 'kt-hidden-list', product_resource: product_resource -%}{%- endcapture -%}
{%- liquid
  assign tell_me_more = product_resource.metafields.custom.tell_me_more | metafield_tag
  if product_resource.metafields.custom.tell_me_more == blank
    assign tell_me_more = block.settings.default_tell_me_more
  endif
  assign shipping = product_resource.metafields.custom.shipping_and_stuff | metafield_tag
  if product_resource.metafields.custom.shipping_and_stuff == blank
    assign shipping = block.settings.default_shipping
  endif
  if hidden contains '|Tell Me More|'
    assign tell_me_more = blank
  endif
  if hidden contains '|Shipping & Stuff|'
    assign shipping = blank
  endif
-%}

{%- if tell_me_more != blank or shipping != blank -%}
  <div
    class="accordion accordion--caret border-style spacing-style accordion--dividers kt-product-accordions"
    style="
      --summary-font-family: var(--font-h5--family);
      --summary-font-style: var(--font-h5--style);
      --summary-font-weight: var(--font-h5--weight);
      --summary-font-size: var(--font-h5--size);
      --summary-font-line-height: var(--font-h5--line-height);
      --summary-font-case: var(--font-h5--case);
      --padding-block-start: max(20px, calc(var(--spacing-scale) * 26px));
      --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px;
      --border-width: 1px; --border-style: none; --border-color: rgb(var(--color-border-rgb) / 1.0); --border-radius: 0px;
    "
    {{ block.shopify_attributes }}
  >
    {%- if tell_me_more != blank -%}
      {%- render 'kt-accordion-row', heading: 'Tell Me More', content: tell_me_more -%}
    {%- endif -%}
    {%- if shipping != blank -%}
      {%- render 'kt-accordion-row', heading: 'Shipping & Stuff', content: shipping -%}
    {%- endif -%}
  </div>
  {% render 'accordion-styles' %}
{%- endif -%}

{% schema %}
{
  "name": "KT dropdowns",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Text shown when a product's own \"Tell Me More\" / \"Shipping & Stuff\" field is empty. Fill those product fields to use different text on one product."
    },
    {
      "type": "richtext",
      "id": "default_tell_me_more",
      "label": "Default Tell Me More"
    },
    {
      "type": "richtext",
      "id": "default_shipping",
      "label": "Default Shipping & Stuff"
    }
  ],
  "presets": [{ "name": "KT dropdowns" }]
}
{% endschema %}
